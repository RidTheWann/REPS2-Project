{
  "$schema": "https://reps2.dev/schemas/design-tokens-v1.json",
  "name": "REPS2 Design System",
  "version": "1.0.0",
  "master": "design-system/reps2/MASTER.md",
  "theme": "dark",
  "color": {
    "surface": {
      "bgDeep": "#070B14",
      "bgBase": "#0B1120",
      "surface1": "#111A2E",
      "surface2": "#16213A",
      "surface3": "#1D2A47",
      "surfaceInset": "#0A0F1C"
    },
    "border": {
      "subtle": "rgba(255,255,255,0.07)",
      "strong": "rgba(255,255,255,0.14)",
      "accent": "rgba(110,139,255,0.45)"
    },
    "text": {
      "primary": "#E8EDF7",
      "secondary": "#A7B4CC",
      "muted": "#7E8DA8",
      "disabled": "#55617A"
    },
    "brand": {
      "base": "#6E8BFF",
      "strong": "#8AA2FF",
      "subtle": "rgba(110,139,255,0.14)",
      "on": "#0A0F1C"
    },
    "run": { "base": "#22C55E", "strong": "#3DDC79", "on": "#04160B" },
    "status": {
      "neutral": "#7C8BA5",
      "info": "#4F8CFF",
      "progress": "#8B7CFF",
      "built": "#22B8CF",
      "test": "#F5A623",
      "playable": "#22C55E",
      "warn": "#F5A623",
      "danger": "#EF4444",
      "blocked": "#E5484D"
    },
    "statusText": {
      "neutral": "#AEB9CC",
      "info": "#7FAEFF",
      "progress": "#B4AAFF",
      "built": "#5FD3E6",
      "test": "#FFC46B",
      "playable": "#5FE08B",
      "warn": "#FFC46B",
      "danger": "#FF6B6B",
      "blocked": "#FF7075"
    },
    "overlay": { "scrim": "rgba(4,7,14,0.62)", "thumb": "rgba(0,0,0,0.45)" }
  },
  "typography": {
    "family": {
      "sans": "Inter",
      "mono": "JetBrains Mono"
    },
    "sizes": {
      "display": "32px",
      "h1": "24px",
      "h2": "20px",
      "h3": "16px",
      "body": "14px",
      "bodySm": "13px",
      "label": "12px",
      "mono": "13px",
      "monoCode": "12.5px"
    },
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "lineHeights": { "display": 1.2, "heading": 1.3, "body": 1.5 },
    "minBodySizePx": 14
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px" },
  "radius": { "sm": "6px", "md": "10px", "lg": "14px", "pill": "999px" },
  "shadow": {
    "sm": "0 1px 2px rgba(0,0,0,0.4)",
    "md": "0 6px 16px rgba(0,0,0,0.45)",
    "lg": "0 18px 40px rgba(0,0,0,0.55)"
  },
  "layout": {
    "topbarHeight": "56px",
    "railWidth": "240px",
    "railWidthCollapsed": "64px",
    "inspectorWidth": "360px",
    "contentMaxWidth": "1600px",
    "breakpoints": [1024, 1280, 1440, 1680],
    "minWindow": { "width": 1024, "height": 720 }
  },
  "motion": {
    "duration": { "micro": "150ms", "standard": "220ms", "complex": "320ms" },
    "easing": {
      "enter": "cubic-bezier(0.16,1,0.3,1)",
      "exit": "cubic-bezier(0.4,0,1,1)"
    },
    "respectsReducedMotion": true
  },
  "icon": { "family": "lucide", "strokeWidth": 1.5, "sizes": { "sm": 16, "md": 20, "lg": 24 } },
  "accessibility": {
    "minContrastBody": 4.5,
    "minContrastLarge": 3.0,
    "minTouchTargetPx": 44,
    "focusRingPx": 2,
    "colorAloneConveysMeaning": false,
    "keyboardComplete": true,
    "controllerNavigable": true
  },
  "statusVocabulary": {
    "imported": { "token": "status.neutral", "icon": "box" },
    "analyzed": { "token": "status.info", "icon": "scan" },
    "translated": { "token": "status.progress", "icon": "code" },
    "native-built": { "token": "status.built", "icon": "cpu" },
    "boot-tested": { "token": "status.test", "icon": "power" },
    "playable": { "token": "status.playable", "icon": "play" },
    "import-failed": { "token": "status.danger", "icon": "alert" },
    "analysis-failed": { "token": "status.danger", "icon": "alert" },
    "translation-incomplete": { "token": "status.warn", "icon": "alert" },
    "native-build-failed": { "token": "status.danger", "icon": "alert" },
    "execution-blocked": { "token": "status.blocked", "icon": "lock" },
    "unsupported": { "token": "status.blocked", "icon": "lock" },
    "recovery-required": { "token": "status.warn", "icon": "refresh" }
  }
}
