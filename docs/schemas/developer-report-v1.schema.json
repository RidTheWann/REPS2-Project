{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridthewann.github.io/REPS2-Project/schemas/developer-report-v1.schema.json",
  "title": "REPS2 Developer CLI Report v1",
  "description": "Stable JSON report envelopes emitted by the reps2 dev command namespace.",
  "oneOf": [
    { "$ref": "#/$defs/sessionList" },
    { "$ref": "#/$defs/sessionInspection" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "manifest": {
      "type": ["object", "null"],
      "description": "The session.json manifest generated by REPS2. Null means it is missing or invalid."
    },
    "event": {
      "type": "object",
      "required": [
        "schema_version",
        "session_id",
        "sequence",
        "timestamp_unix_ms",
        "elapsed_ms",
        "severity",
        "category",
        "subsystem",
        "event",
        "message",
        "context"
      ],
      "properties": {
        "schema_version": { "type": "integer" },
        "session_id": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 1 },
        "timestamp_unix_ms": { "type": "integer", "minimum": 0 },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "severity": { "type": "string", "enum": ["info", "warning", "error"] },
        "category": { "type": "string" },
        "subsystem": { "type": "string" },
        "event": { "type": "string" },
        "message": { "type": "string" },
        "context": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "sessionList": {
      "type": "object",
      "required": ["schema_version", "kind", "status", "log_root", "count", "sessions"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "reps2.developer.session_list" },
        "status": { "const": "ok" },
        "log_root": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["session_id", "directory", "complete", "event_count", "diagnostic_count", "manifest", "integrity_errors"],
            "properties": {
              "session_id": { "type": "string", "pattern": "^session-[A-Za-z0-9-]+$" },
              "directory": { "type": "string" },
              "complete": { "type": "boolean" },
              "event_count": { "type": "integer", "minimum": 0 },
              "diagnostic_count": { "type": "integer", "minimum": 0 },
              "manifest": { "$ref": "#/$defs/manifest" },
              "integrity_errors": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "sessionInspection": {
      "type": "object",
      "required": ["schema_version", "kind", "status", "session_id", "session_directory", "complete", "manifest", "event_count", "events", "diagnostic_count", "diagnostics", "integrity_errors"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "reps2.developer.session_inspection" },
        "status": { "const": "ok" },
        "session_id": { "type": "string" },
        "session_directory": { "type": "string" },
        "complete": { "type": "boolean" },
        "manifest": { "$ref": "#/$defs/manifest" },
        "event_count": { "type": "integer", "minimum": 0 },
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
        "diagnostic_count": { "type": "integer", "minimum": 0 },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/event" } },
        "integrity_errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["schema_version", "kind", "status", "error"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "reps2.developer.error" },
        "status": { "const": "error" },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
