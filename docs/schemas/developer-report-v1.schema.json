{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridthewann.github.io/REPS2-Project/schemas/developer-report-v1.schema.json",
  "title": "REPS2 Developer CLI Report v1",
  "description": "Stable JSON report envelopes emitted by the reps2 dev command namespace.",
  "oneOf": [
    { "$ref": "#/$defs/sessionList" },
    { "$ref": "#/$defs/sessionInspection" },
    { "$ref": "#/$defs/sessionSummary" },
    { "$ref": "#/$defs/sessionComparison" },
    { "$ref": "#/$defs/capabilities" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "manifest": {
      "type": ["object", "null"],
      "description": "The session.json manifest generated by REPS2. Null means it is missing or invalid."
    },
    "event": {
      "type": "object",
      "required": [
        "schema_version",
        "session_id",
        "sequence",
        "timestamp_unix_ms",
        "elapsed_ms",
        "severity",
        "category",
        "subsystem",
        "event",
        "message",
        "context"
      ],
      "properties": {
        "schema_version": { "type": "integer" },
        "session_id": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 1 },
        "timestamp_unix_ms": { "type": "integer", "minimum": 0 },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "severity": { "type": "string" },
        "category": { "type": "string" },
        "subsystem": { "type": "string" },
        "event": { "type": "string" },
        "message": { "type": "string" },
        "context": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "sessionList": {
      "type": "object",
      "required": ["schema_version", "kind", "status", "log_root", "count", "available_count", "truncated", "sessions"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "reps2.developer.session_list" },
        "status": { "const": "ok" },
        "log_root": { "type": "string" },
        "count": { "type": "integer", "minimum": 0, "description": "Number of sessions included in this response." },
        "available_count": { "type": "integer", "minimum": 0, "description": "Number of session directories discovered before applying the requested limit." },
        "truncated": { "type": "boolean", "description": "True when not every discovered session is included in this response." },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["session_id", "directory", "complete", "event_count", "diagnostic_count", "manifest", "integrity_errors"],
            "properties": {
              "session_id": { "type": "string", "pattern": "^session-[A-Za-z0-9-]+$" },
              "directory": { "type": "string" },
              "complete": { "type": "boolean" },
              "event_count": { "type": "integer", "minimum": 0 },
              "diagnostic_count": { "type": "integer", "minimum": 0 },
              "manifest": { "$ref": "#/$defs/manifest" },
              "integrity_errors": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "sessionInspection": {
      "type": "object",
      "required": ["schema_version", "kind", "status", "session_id", "session_directory", "complete", "manifest", "event_count", "events", "diagnostic_count", "diagnostics", "integrity_errors"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "reps2.developer.session_inspection" },
        "status": { "const": "ok" },
        "session_id": { "type": "string" },
        "session_directory": { "type": "string" },
        "complete": { "type": "boolean" },
        "manifest": { "$ref": "#/$defs/manifest" },
        "event_count": { "type": "integer", "minimum": 0 },
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
        "diagnostic_count": { "type": "integer", "minimum": 0 },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/event" } },
        "integrity_errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["schema_version", "kind", "status", "error"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "reps2.developer.error" },
        "status": { "const": "error" },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "description": "Machine-readable developer diagnostics contract emitted by `reps2 dev capabilities`.",
      "required": [
        "schema_version",
        "kind",
        "status",
        "tool_version",
        "report_schema_version",
        "event_schema_version",
        "session_manifest_schema_version",
        "report_schema_path",
        "artifact_names",
        "envelope_kinds",
        "commands",
        "diagnostic_codes",
        "log_root_policy",
        "privacy"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "reps2.developer.capabilities" },
        "status": { "const": "ok" },
        "tool_version": { "type": "string" },
        "report_schema_version": { "type": "integer", "minimum": 1 },
        "event_schema_version": { "type": "integer", "minimum": 1 },
        "session_manifest_schema_version": { "type": "integer", "minimum": 1 },
        "report_schema_path": { "type": "string" },
        "artifact_names": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "envelope_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^reps2\\.developer\\.[a-z_]+$" }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "usage", "description"],
            "properties": {
              "name": { "type": "string" },
              "usage": { "type": "string" },
              "description": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "diagnostic_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["code", "severity", "scope", "surface", "description"],
            "properties": {
              "code": { "type": "string", "pattern": "^REPS2_[A-Z0-9_]+$" },
              "severity": { "type": "string" },
              "scope": { "type": "string" },
              "surface": { "enum": ["event", "report"] },
              "description": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "log_root_policy": {
          "type": "object",
          "required": ["env_override", "description"],
          "properties": {
            "env_override": { "type": "string" },
            "description": { "type": "string" }
          },
          "additionalProperties": false
        },
        "privacy": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sessionSummary": {
      "type": "object",
      "description": "Compact structured session summary written to summary.json and echoed by `reps2 dev summary`.",
      "required": [
        "schema_version",
        "kind",
        "status",
        "session_id",
        "command",
        "tool_version",
        "host_platform",
        "outcome",
        "finished_unix_ms",
        "event_count",
        "diagnostic_count",
        "diagnostic_records_dropped",
        "reproduction",
        "failures"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "reps2.developer.session_summary" },
        "status": { "const": "ok" },
        "session_id": { "type": "string" },
        "command": { "type": "string" },
        "tool_version": { "type": "string" },
        "host_platform": { "type": "string" },
        "outcome": { "type": "string" },
        "finished_unix_ms": { "type": "integer", "minimum": 0 },
        "event_count": { "type": "integer", "minimum": 0 },
        "diagnostic_count": { "type": "integer", "minimum": 0 },
        "diagnostic_records_dropped": { "type": "integer", "minimum": 0 },
        "reproduction": {
          "type": "object",
          "description": "The invocation that produced this session, for reproduction.",
          "required": ["program", "arguments"],
          "properties": {
            "program": { "type": "string" },
            "arguments": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sequence",
              "severity",
              "category",
              "subsystem",
              "event",
              "message",
              "code",
              "scope",
              "stage_id"
            ],
            "properties": {
              "sequence": { "type": "integer", "minimum": 1 },
              "severity": { "type": "string" },
              "category": { "type": "string" },
              "subsystem": { "type": "string" },
              "event": { "type": "string" },
              "message": { "type": "string" },
              "code": { "type": ["string", "null"] },
              "scope": { "type": ["string", "null"] },
              "stage_id": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "summaryView": {
      "type": "object",
      "description": "One side of a session comparison.",
      "required": [
        "session_id",
        "command",
        "outcome",
        "diagnostic_count",
        "failure_count",
        "failure_signatures"
      ],
      "properties": {
        "session_id": { "type": "string" },
        "command": { "type": "string" },
        "outcome": { "type": "string" },
        "diagnostic_count": { "type": "integer" },
        "failure_count": { "type": "integer", "minimum": 0 },
        "failure_signatures": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "sessionComparison": {
      "type": "object",
      "description": "Deterministic comparison of two session summaries emitted by `reps2 dev compare`.",
      "required": [
        "schema_version",
        "kind",
        "status",
        "base",
        "candidate",
        "identical",
        "command_changed",
        "outcome_changed",
        "added",
        "removed"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "reps2.developer.session_comparison" },
        "status": { "const": "ok" },
        "base": { "$ref": "#/$defs/summaryView" },
        "candidate": { "$ref": "#/$defs/summaryView" },
        "identical": { "type": "boolean" },
        "command_changed": { "type": "boolean" },
        "outcome_changed": { "type": "boolean" },
        "added": { "type": "array", "items": { "type": "string" } },
        "removed": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
