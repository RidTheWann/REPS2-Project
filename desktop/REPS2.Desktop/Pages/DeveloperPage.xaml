<Page
    x:Class="REPS2.Desktop.Pages.DeveloperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">
    <Grid Padding="64,32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="SYSTEM / DEVELOPER" FontSize="12" FontWeight="SemiBold"
                           CharacterSpacing="45" Foreground="{ThemeResource MutedTextBrush}"/>
                <TextBlock Text="See exactly what happened." Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Logs, diagnostic reports and artifact inspection — without inferred success."
                           Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Run CLI report" VerticalAlignment="Center">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Capabilities" Click="Capabilities_Click"/>
                        <MenuFlyoutItem Text="Sessions" Click="Sessions_Click"/>
                        <MenuFlyoutItem Text="Inspect latest" Click="InspectLatest_Click"/>
                        <MenuFlyoutItem Text="Summary latest" Click="SummaryLatest_Click"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="{ThemeResource SurfaceOneBrush}" CornerRadius="6"
                Padding="20,12">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="206"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="LOCAL WORKSPACE" Style="{StaticResource SectionLabelStyle}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="No session selected" FontSize="14"
                           VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="{ThemeResource SurfaceTwoBrush}" CornerRadius="5"
                        Padding="14,8">
                    <TextBlock Text="Report required" Style="{StaticResource CaptionStyle}"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.85*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{ThemeResource SurfaceOneBrush}" CornerRadius="8" Padding="24">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Logs" FontSize="20" FontWeight="SemiBold"/>
                    <Grid Grid.Row="1" ColumnSpacing="16"
                          Visibility="{x:Bind ViewModel.LogsEmptyVisible, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TIME" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Grid.Column="1" Text="LEVEL" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Grid.Column="2" Text="MESSAGE" Style="{StaticResource SectionLabelStyle}"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                                    Visibility="{x:Bind ViewModel.LogsEmptyVisible, Mode=OneWay}">
                            <TextBlock Text="No log entries to display." FontSize="22" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Attach a diagnostic report to inspect recorded events."
                                       Style="{StaticResource PageSubtitleStyle}" TextAlignment="Center"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      Visibility="{x:Bind ViewModel.HasOutput, Mode=OneWay}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="CLI REPORT OUTPUT" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Text="{x:Bind ViewModel.Header, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}"/>
                                <TextBlock Text="{x:Bind ViewModel.Output, Mode=OneWay}"
                                           FontSize="12" FontFamily="Cascadia Mono, Consolas"
                                           Foreground="{ThemeResource PrimaryTextBrush}"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <TextBlock Grid.Row="3"
                               Text="CLI results are shown verbatim; unstructured output does not establish compatibility."
                               Style="{StaticResource CaptionStyle}"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{ThemeResource SurfaceOneBrush}" CornerRadius="8" Padding="24">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Inspector" FontSize="20" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="14" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Artifact" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Grid.Column="1" Text="Not selected" FontSize="12"/>
                            <TextBlock Grid.Row="1" Text="Provenance" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Unavailable" FontSize="12"/>
                            <TextBlock Grid.Row="2" Text="Build evidence" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Not attached" FontSize="12"/>
                            <TextBlock Grid.Row="3" Text="Guest boot evidence" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Not verified" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="{ThemeResource SurfaceOneBrush}" CornerRadius="8" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Diagnostics" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="No report attached." FontSize="14"/>
                        <TextBlock Text="Unsupported boundaries must fail explicitly."
                                   Style="{StaticResource PageSubtitleStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
