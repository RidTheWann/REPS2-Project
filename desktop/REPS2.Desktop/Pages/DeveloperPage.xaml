<Page
    x:Class="REPS2.Desktop.Pages.DeveloperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">
    <Grid Padding="30" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="5">
            <TextBlock Text="Developer Center" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
            <TextBlock Text="Versioned CLI reports and session diagnostics. Paths may contain private local information." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="9">
            <Button Click="Capabilities_Click">Capabilities</Button>
            <Button Click="Sessions_Click">Sessions</Button>
            <Button Click="InspectLatest_Click">Inspect latest</Button>
            <Button Click="SummaryLatest_Click">Summary latest</Button>
        </StackPanel>
        <Border Grid.Row="2" Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="OutputHeader" Text="Choose a diagnostic report" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBlock x:Name="OutputText" Text="REPS2 developer reports are generated by the Rust frontend. The desktop UI does not scrape human-oriented CLI messages for compatibility state."
                               FontSize="12" FontFamily="Consolas" Foreground="{StaticResource PrimaryTextBrush}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
