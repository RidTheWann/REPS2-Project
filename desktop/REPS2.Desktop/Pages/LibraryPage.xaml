<Page
    x:Class="REPS2.Desktop.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:REPS2.Desktop.Api.Contracts"
    Background="{ThemeResource AppBackgroundBrush}">
    <Grid Padding="64,32" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.CollectionLabel, Mode=OneWay}" FontSize="12"
                           FontWeight="SemiBold" CharacterSpacing="45"
                           Foreground="{ThemeResource MutedTextBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}"
                           Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <Button Grid.Column="1" Click="AddGame_Click" Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.CollectionControlsVisible, Mode=OneWay}"
                    VerticalAlignment="Center" MinWidth="170">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="13"/>
                    <TextBlock Text="ADD GAME" Style="{StaticResource AccentButtonTextStyle}"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16"
              Visibility="{x:Bind ViewModel.CollectionControlsVisible, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="218"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="204"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Search your collection"
                     TextChanged="SearchBox_TextChanged"/>
            <ComboBox x:Name="LibraryFilterBox" Grid.Column="1" SelectedIndex="0"
                      SelectedValuePath="Tag" SelectionChanged="Filters_SelectionChanged">
                <ComboBoxItem Content="All titles" Tag="All"/>
                <ComboBoxItem Content="Needs review" Tag="NeedsReview"/>
                <ComboBoxItem Content="Ready to build" Tag="ReadyToBuild"/>
                <ComboBoxItem Content="Native-built or later" Tag="NativeBuilt"/>
                <ComboBoxItem Content="Playable only" Tag="Playable"/>
            </ComboBox>
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ResultsSummary, Mode=OneWay}"
                       Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
            <ComboBox x:Name="LibrarySortBox" Grid.Column="3" SelectedIndex="0" SelectedValuePath="Tag"
                      SelectionChanged="Filters_SelectionChanged">
                <ComboBoxItem Content="Sort: Title A–Z" Tag="NameAscending"/>
                <ComboBoxItem Content="Sort: Title Z–A" Tag="NameDescending"/>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2">
            <GridView x:Name="GamesGrid" ItemsSource="{x:Bind ViewModel.VisibleGames}" IsItemClickEnabled="True"
                      Visibility="{x:Bind ViewModel.GamesVisible, Mode=OneWay}"
                      SelectionMode="None" ItemClick="GamesGrid_ItemClick"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollMode="Auto">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:GameSummary">
                        <StackPanel Width="202" Margin="0,0,16,14" Spacing="12">
                            <Border Width="202" Height="286" CornerRadius="4"
                                    Background="{ThemeResource SurfaceOneBrush}"
                                    BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid Padding="14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="REPS2" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="PS2" FontSize="11" CharacterSpacing="20"
                                                   Foreground="{ThemeResource MutedTextBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <Ellipse Width="128" Height="128" Stroke="{ThemeResource BorderSubtleBrush}"
                                                 StrokeThickness="1" HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                        <Ellipse Width="88" Height="88" Stroke="{ThemeResource NavigationAccentBrush}"
                                                 StrokeThickness="1" HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="PS2" FontSize="28" FontWeight="Light" CharacterSpacing="20"
                                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Grid.Row="2" Text="{x:Bind DisplayName}" FontSize="12"
                                               FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                               TextAlignment="Center"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{x:Bind DisplayName}" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            <TextBlock Text="{x:Bind LifecycleLabel}" FontSize="12"
                                       Foreground="{ThemeResource MutedTextBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Grid x:Name="EmptyStatePanel" Visibility="{x:Bind ViewModel.EmptyVisible, Mode=OneWay}">
                <Border Background="{ThemeResource SurfaceOneBrush}" CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="18" MaxWidth="720" Padding="24">
                        <Border Width="112" Height="150" CornerRadius="6"
                                Background="{ThemeResource SurfaceTwoBrush}"
                                BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="PS2" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{ThemeResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Width="64" Height="1" Background="{ThemeResource BorderSubtleBrush}"
                                        VerticalAlignment="Center" Margin="0,38,0,0"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="EmptyStateTitle" Text="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}"
                                   FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                        <TextBlock x:Name="EmptyStateDescription"
                                   Text="{x:Bind ViewModel.EmptyStateDescription, Mode=OneWay}"
                                   Style="{StaticResource PageSubtitleStyle}" TextAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Button x:Name="EmptyAddButton" Click="AddGame_Click"
                                Visibility="{x:Bind ViewModel.EmptyAddVisible, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" MinWidth="170">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                <TextBlock Text="ADD GAME" Style="{StaticResource AccentButtonTextStyle}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClearFiltersButton" Click="ClearFilters_Click"
                                Visibility="{x:Bind ViewModel.ClearFiltersVisible, Mode=OneWay}"
                                Content="Clear filters"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel x:Name="ErrorStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12" MaxWidth="560"
                        Visibility="{x:Bind ViewModel.ErrorVisible, Mode=OneWay}">
                <TextBlock Text="The library could not be read" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.EmptyStateDescription, Mode=OneWay}"
                           Style="{StaticResource PageSubtitleStyle}" TextAlignment="Center"
                           AutomationProperties.LiveSetting="Assertive"/>
                <Button Click="Refresh_Click" Content="Try again" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="{ThemeResource SurfaceOneBrush}" CornerRadius="6"
                Padding="14,10"
                Visibility="{x:Bind ViewModel.CollectionControlsVisible, Mode=OneWay}">
            <TextBlock x:Name="LibraryNotice" Text="{x:Bind ViewModel.Notice, Mode=OneWay}"
                       Style="{StaticResource CaptionStyle}"/>
        </Border>
    </Grid>
</Page>
