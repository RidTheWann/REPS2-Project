<Page
    x:Class="REPS2.Desktop.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:REPS2.Desktop.Core.Models"
    Background="{StaticResource AppBackgroundBrush}">
    <Grid Padding="28,24,28,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="5">
                <TextBlock Text="Your PlayStation 2 library" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="One ISO per game. Native preparation and compatibility are tracked separately." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
                <Button Click="AddGame_Click" Background="{StaticResource BrandBrush}" Foreground="#0A0F1C" BorderThickness="0" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE710;" FontSize="13"/>
                        <TextBlock Text="Add game"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Search title, serial, disc ID, or status…" TextChanged="SearchBox_TextChanged"/>
            <ComboBox x:Name="LibraryFilterBox" Grid.Column="1" SelectedIndex="0" SelectedValuePath="Tag"
                      SelectionChanged="Filters_SelectionChanged" MinHeight="38">
                <ComboBoxItem Content="All titles" Tag="All"/>
                <ComboBoxItem Content="Needs review" Tag="NeedsReview"/>
                <ComboBoxItem Content="Ready to build" Tag="ReadyToBuild"/>
                <ComboBoxItem Content="Native-built+" Tag="NativeBuilt"/>
                <ComboBoxItem Content="Playable only" Tag="Playable"/>
            </ComboBox>
            <ComboBox x:Name="LibrarySortBox" Grid.Column="2" SelectedIndex="0" SelectedValuePath="Tag"
                      SelectionChanged="Filters_SelectionChanged" MinHeight="38">
                <ComboBoxItem Content="Title · A to Z" Tag="NameAscending"/>
                <ComboBoxItem Content="Title · Z to A" Tag="NameDescending"/>
            </ComboBox>
            <TextBlock x:Name="ResultsSummary" Grid.Column="3" Text="0 of 0 titles"
                       FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center" Margin="4,0,0,0"/>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfaceOneBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                <StackPanel Spacing="2">
                    <TextBlock Text="LIBRARY" FontSize="10" CharacterSpacing="90" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="LibraryCount" Text="0 titles" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource SurfaceOneBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                <StackPanel Spacing="2">
                    <TextBlock Text="NATIVE-BUILT" FontSize="10" CharacterSpacing="90" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="BuiltCount" Text="0 titles" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BuiltBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource SurfaceOneBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                <StackPanel Spacing="2">
                    <TextBlock Text="PLAYABLE" FontSize="10" CharacterSpacing="90" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="PlayableCount" Text="0 titles" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <GridView x:Name="GamesGrid" ItemsSource="{x:Bind VisibleGames}" IsItemClickEnabled="True"
                      SelectionMode="None" ItemClick="GamesGrid_ItemClick"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollMode="Auto">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:GameSummary">
                        <Border Width="276" Height="238" Margin="0,0,12,12" Padding="14"
                                Background="{StaticResource SurfaceOneBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="12">
                            <Grid RowSpacing="9">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="104"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource SurfaceTwoBrush}" CornerRadius="8" Grid.Row="0">
                                    <Grid>
                                        <TextBlock Text="PLAYSTATION 2" FontSize="10" CharacterSpacing="180"
                                                   Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <FontIcon Glyph="&#xE768;" FontSize="26" Foreground="{StaticResource BrandBrush}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,10"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Spacing="3">
                                    <TextBlock Text="{x:Bind DisplayName}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="11" FontFamily="Consolas"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{x:Bind EvidenceNote}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" MaxLines="2"/>
                                </StackPanel>
                                <Grid Grid.Row="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource BrandSubtleBrush}" CornerRadius="5" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind LifecycleLabel}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InfoBrush}"/>
                                    </Border>
                                    <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel x:Name="EmptyStatePanel" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                <Border Width="76" Height="76" CornerRadius="20" Background="{StaticResource SurfaceTwoBrush}" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE7FC;" FontSize="32" Foreground="{StaticResource BrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="EmptyStateTitle" Text="Your library is ready" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyStateDescription"
                           Text="Add one raw PS2 ISO you own. REPS2 will validate the disc and keep its source file in place."
                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <Button x:Name="EmptyAddButton" Click="AddGame_Click" Background="{StaticResource BrandBrush}"
                        Foreground="#0A0F1C" BorderThickness="0" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="13"/>
                        <TextBlock Text="Add your first game"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ClearFiltersButton" Click="ClearFilters_Click" Visibility="Collapsed"
                        HorizontalAlignment="Center">
                    <TextBlock Text="Clear filters"/>
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="LibraryNotice" Grid.Row="4" Text="Play is reserved for titles with independently evidenced gameplay acceptance."
                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
    </Grid>
</Page>
