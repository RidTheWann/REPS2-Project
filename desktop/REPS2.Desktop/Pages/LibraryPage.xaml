<Page
    x:Class="REPS2.Desktop.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:REPS2.Desktop.Api.Contracts"
    Background="{ThemeResource AppBackgroundBrush}">
    <Grid Padding="28,24,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Your library" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="The games you own, all in one place. Lifecycle labels reflect evidence, not assumptions."
                           Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="Refresh_Click" ToolTipService.ToolTip="Refresh library">
                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                </Button>
                <Button Click="AddGame_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="13"/>
                        <TextBlock Text="Add game"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Search title, serial, disc ID, or status" TextChanged="SearchBox_TextChanged"/>
            <ComboBox x:Name="LibraryFilterBox" Grid.Column="1" SelectedIndex="0" SelectedValuePath="Tag"
                      SelectionChanged="Filters_SelectionChanged">
                <ComboBoxItem Content="All titles" Tag="All"/>
                <ComboBoxItem Content="Needs review" Tag="NeedsReview"/>
                <ComboBoxItem Content="Ready to build" Tag="ReadyToBuild"/>
                <ComboBoxItem Content="Native-built or later" Tag="NativeBuilt"/>
                <ComboBoxItem Content="Playable only" Tag="Playable"/>
            </ComboBox>
            <ComboBox x:Name="LibrarySortBox" Grid.Column="2" SelectedIndex="0" SelectedValuePath="Tag"
                      SelectionChanged="Filters_SelectionChanged">
                <ComboBoxItem Content="Title · A to Z" Tag="NameAscending"/>
                <ComboBoxItem Content="Title · Z to A" Tag="NameDescending"/>
            </ComboBox>
            <TextBlock x:Name="ResultsSummary" Grid.Column="3" Text="{x:Bind ViewModel.ResultsSummary, Mode=OneWay}"
                       Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Padding="18,12" Spacing="2">
                    <TextBlock Text="Titles" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="LibraryCount" Text="{x:Bind ViewModel.LibraryCount, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{ThemeResource PrimaryTextBrush}"/>
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1,0,1,0">
                    <StackPanel Padding="18,12" Spacing="2">
                        <TextBlock Text="Native-built" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="BuiltCount" Text="{x:Bind ViewModel.BuiltCount, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{ThemeResource BuiltBrush}"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Padding="18,12" Spacing="2">
                    <TextBlock Text="Playable" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="PlayableCount" Text="{x:Bind ViewModel.PlayableCount, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{ThemeResource SecondaryTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <GridView x:Name="GamesGrid" ItemsSource="{x:Bind ViewModel.VisibleGames}" IsItemClickEnabled="True"
                      Visibility="{x:Bind ViewModel.GamesVisible, Mode=OneWay}"
                      SelectionMode="None" ItemClick="GamesGrid_ItemClick"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollMode="Auto">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:GameSummary">
                        <Border Width="178" Height="340" Margin="0,0,10,10"
                                Background="{ThemeResource SurfaceOneBrush}"
                                BorderBrush="{ThemeResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="232"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="{ThemeResource SurfaceTwoBrush}" CornerRadius="7,7,0,0"
                                        BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                    <Grid Padding="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="PLAYSTATION 2" FontSize="12" FontWeight="SemiBold"
                                                   CharacterSpacing="60" Foreground="{ThemeResource MutedTextBrush}"
                                                   VerticalAlignment="Top"/>
                                        <Grid Grid.Row="1">
                                            <Ellipse Width="112" Height="112" Stroke="{ThemeResource BorderSubtleBrush}"
                                                     StrokeThickness="1" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                            <Ellipse Width="78" Height="78" Stroke="{ThemeResource NavigationAccentBrush}"
                                                     StrokeThickness="1" Opacity="0.7" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="PS2" FontSize="24" FontWeight="Light" CharacterSpacing="20"
                                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Grid.Row="2" Text="NO GAME ART" FontSize="12"
                                                   Foreground="{ThemeResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Padding="10,9" Spacing="5">
                                    <TextBlock Text="{x:Bind DisplayName}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{ThemeResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"
                                               MaxLines="2"/>
                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="10" FontFamily="Cascadia Mono, Consolas"
                                               Foreground="{ThemeResource SecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Background="{ThemeResource BrandSubtleBrush}" CornerRadius="5" Padding="6,3"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind LifecycleLabel}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource BrandBrush}"/>
                                    </Border>
                                    <TextBlock Text="{x:Bind EvidenceNote}" FontSize="12"
                                               Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" MaxLines="2"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel x:Name="EmptyStatePanel" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
                        Visibility="{x:Bind ViewModel.EmptyVisible, Mode=OneWay}">
                <Border Width="56" Height="56" CornerRadius="14" Background="{ThemeResource SurfaceTwoBrush}"
                        BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE7FC;" FontSize="24" Foreground="{ThemeResource BrandBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="EmptyStateTitle" Text="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{ThemeResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyStateDescription"
                           Text="{x:Bind ViewModel.EmptyStateDescription, Mode=OneWay}"
                           Style="{StaticResource PageSubtitleStyle}" TextAlignment="Center"/>
                <Button x:Name="EmptyAddButton" Click="AddGame_Click" Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.EmptyAddVisible, Mode=OneWay}"
                        HorizontalAlignment="Center" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="13"/>
                        <TextBlock Text="Add your first game"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ClearFiltersButton" Click="ClearFilters_Click"
                        Visibility="{x:Bind ViewModel.ClearFiltersVisible, Mode=OneWay}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="Clear filters"/>
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="LibraryNotice" Grid.Row="4"
                   Text="{x:Bind ViewModel.Notice, Mode=OneWay}"
                   Style="{StaticResource CaptionStyle}"/>
    </Grid>
</Page>