<Page
    x:Class="REPS2.Desktop.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:REPS2.Desktop.Core.Models"
    Background="{ThemeResource AppBackgroundBrush}">
    <Grid Padding="28,24,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Library" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="One ISO per game. Analysis, native build and compatibility are tracked as separate evidence states."
                           Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <Button Grid.Column="1" Click="Refresh_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Search title, serial, disc ID, or status" TextChanged="SearchBox_TextChanged"/>
            <ComboBox x:Name="LibraryFilterBox" Grid.Column="1" SelectedIndex="0" SelectedValuePath="Tag"
                      SelectionChanged="Filters_SelectionChanged">
                <ComboBoxItem Content="All titles" Tag="All"/>
                <ComboBoxItem Content="Needs review" Tag="NeedsReview"/>
                <ComboBoxItem Content="Ready to build" Tag="ReadyToBuild"/>
                <ComboBoxItem Content="Native-built or later" Tag="NativeBuilt"/>
                <ComboBoxItem Content="Playable only" Tag="Playable"/>
            </ComboBox>
            <ComboBox x:Name="LibrarySortBox" Grid.Column="2" SelectedIndex="0" SelectedValuePath="Tag"
                      SelectionChanged="Filters_SelectionChanged">
                <ComboBoxItem Content="Title · A to Z" Tag="NameAscending"/>
                <ComboBoxItem Content="Title · Z to A" Tag="NameDescending"/>
            </ComboBox>
            <TextBlock x:Name="ResultsSummary" Grid.Column="3" Text="0 of 0 titles"
                       Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Padding="18,12" Spacing="2">
                    <TextBlock Text="Titles" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="LibraryCount" Text="0" FontSize="20" FontWeight="SemiBold"
                               Foreground="{ThemeResource PrimaryTextBrush}"/>
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1,0,1,0">
                    <StackPanel Padding="18,12" Spacing="2">
                        <TextBlock Text="Native-built" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="BuiltCount" Text="0" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{ThemeResource BuiltBrush}"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Padding="18,12" Spacing="2">
                    <TextBlock Text="Playable" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="PlayableCount" Text="0" FontSize="20" FontWeight="SemiBold"
                               Foreground="{ThemeResource SecondaryTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <GridView x:Name="GamesGrid" ItemsSource="{x:Bind VisibleGames}" IsItemClickEnabled="True"
                      SelectionMode="None" ItemClick="GamesGrid_ItemClick"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollMode="Auto">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="5"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:GameSummary">
                        <Border Width="248" Height="212" Margin="0,0,10,10"
                                Background="{ThemeResource SurfaceOneBrush}"
                                BorderBrush="{ThemeResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="88"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Background="{ThemeResource SurfaceTwoBrush}" CornerRadius="9,9,0,0"
                                        BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                    <Grid Padding="14,12">
                                        <TextBlock Text="PLAYSTATION 2" FontSize="10" FontWeight="SemiBold"
                                                   CharacterSpacing="60" Foreground="{ThemeResource MutedTextBrush}"
                                                   VerticalAlignment="Top"/>
                                        <TextBlock Text="PS2" FontSize="26" FontWeight="Bold"
                                                   Foreground="{ThemeResource BorderSubtleBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Padding="14,10" Spacing="3">
                                    <TextBlock Text="{x:Bind DisplayName}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{ThemeResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="11" FontFamily="Cascadia Mono, Consolas"
                                               Foreground="{ThemeResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{x:Bind EvidenceNote}" FontSize="11" Foreground="{ThemeResource MutedTextBrush}"
                                               TextWrapping="Wrap" MaxLines="2"/>
                                </StackPanel>
                                <Grid Grid.Row="2" Padding="14,0,14,12" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource BrandSubtleBrush}" CornerRadius="5" Padding="7,3"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind LifecycleLabel}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource BrandBrush}"/>
                                    </Border>
                                    <TextBlock Text="Open details" Grid.Column="1" FontSize="11"
                                               Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11"
                                              Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel x:Name="EmptyStatePanel" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                <Border Width="56" Height="56" CornerRadius="14" Background="{ThemeResource SurfaceTwoBrush}"
                        BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE7FC;" FontSize="24" Foreground="{ThemeResource BrandBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="EmptyStateTitle" Text="No games in this library" FontSize="20" FontWeight="SemiBold"
                           Foreground="{ThemeResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyStateDescription"
                           Text="Add a raw PS2 ISO you own. REPS2 validates the disc and keeps the source file at its original path."
                           Style="{StaticResource PageSubtitleStyle}" TextAlignment="Center"/>
                <Button x:Name="EmptyAddButton" Click="AddGame_Click" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="13"/>
                        <TextBlock Text="Add your first game"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ClearFiltersButton" Click="ClearFilters_Click" Visibility="Collapsed"
                        HorizontalAlignment="Center">
                    <TextBlock Text="Clear filters"/>
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="LibraryNotice" Grid.Row="4"
                   Text="Play remains unavailable until a documented gameplay acceptance plan passes."
                   Style="{StaticResource CaptionStyle}"/>
    </Grid>
</Page>