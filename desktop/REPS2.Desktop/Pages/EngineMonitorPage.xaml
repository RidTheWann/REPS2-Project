<Page
    x:Class="REPS2.Desktop.Pages.EngineMonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">
    <Grid Padding="48,32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock Text="SYSTEM / RUNTIME" FontSize="12" FontWeight="SemiBold"
                       CharacterSpacing="45" Foreground="{ThemeResource MutedTextBrush}"/>
            <TextBlock Text="RG REPS2 Engine monitor" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Session evidence and runtime reports. Never a simulated performance dashboard."
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{ThemeResource SurfaceTwoBrush}" CornerRadius="8" Padding="18,16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse Width="10" Height="10" Fill="{ThemeResource MutedTextBrush}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="No active engine session" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Waiting for a structured run report"
                           Style="{StaticResource PageSubtitleStyle}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="SESSION" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Text="—" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="No session attached" Style="{StaticResource CaptionStyle}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="NATIVE MODULE" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Text="—" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="No module selected" Style="{StaticResource CaptionStyle}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="EXECUTION RESULT" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Text="—" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="No report received" Style="{StaticResource CaptionStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Run report" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="No structured report available." FontSize="16"/>
                    <TextBlock Text="A bounded diagnostic run is not proof that a retail title boots. Values appear here only when an actual report is attached."
                               Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Inspect the evidence" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Open logs, diagnostics and artifacts in Developer mode."
                               Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
                    <TextBlock Text="Unsupported boundaries must fail explicitly."
                               Style="{StaticResource CaptionStyle}"/>
                    <Button Click="OpenDeveloper_Click" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Left">
                        <TextBlock Text="Open Developer mode" Style="{StaticResource AccentButtonTextStyle}"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
