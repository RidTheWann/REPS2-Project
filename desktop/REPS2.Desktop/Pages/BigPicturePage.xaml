<Page
    x:Class="REPS2.Desktop.Pages.BigPicturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">
    <Grid x:Name="PageRoot" IsTabStop="True" KeyDown="PageRoot_KeyDown"
          Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <Border Background="{ThemeResource DeepSurfaceBrush}"
                BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="32,0" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="REPS2" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="BIG PICTURE" FontSize="12" CharacterSpacing="60"
                               Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="←  →  Browse     Enter  Check readiness     D  Details     Esc  Back"
                           FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Click="Exit_Click" MinHeight="44">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8BB;" FontSize="15"/>
                        <TextBlock Text="Exit Big Picture"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid x:Name="CarouselLayout" Grid.Row="1" Padding="38,18" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="PreviousPreviewCard" Grid.Column="0" Width="190" Height="268" CornerRadius="10" Padding="14"
                    Background="{ThemeResource SurfaceOneBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}"
                    BorderThickness="1" Opacity="0.62" VerticalAlignment="Center" HorizontalAlignment="Right"
                    Margin="0,0,20,0">
            <StackPanel VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="PREVIOUS" FontSize="12" CharacterSpacing="45"
                           Foreground="{ThemeResource MutedTextBrush}"/>
                <Border Height="138" CornerRadius="5" Background="{ThemeResource SurfaceTwoBrush}"
                        BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1">
                    <Grid>
                        <Ellipse Width="82" Height="82" Stroke="{ThemeResource BorderSubtleBrush}"
                                 StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse Width="58" Height="58" Stroke="{ThemeResource NavigationAccentBrush}"
                                 StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="PS2" FontSize="22" FontWeight="Light" CharacterSpacing="15"
                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Text="{x:Bind ViewModel.PreviousTitle, Mode=OneWay}" FontSize="15"
                           FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}"
                           TextWrapping="Wrap" MaxLines="2"/>
            </StackPanel>
            </Border>

            <Button Grid.Column="1" Click="Previous_Click" IsEnabled="{x:Bind ViewModel.HasMultipleGames, Mode=OneWay}"
                    VerticalAlignment="Center" Margin="0,0,18,0" MinWidth="52" MinHeight="56"
                    AutomationProperties.Name="Previous title"
                    Visibility="{x:Bind ViewModel.HasMultipleGames, Mode=OneWay}" ToolTipService.ToolTip="Previous title">
                <FontIcon Glyph="&#xE76B;" FontSize="20"/>
            </Button>

            <StackPanel Grid.Column="2" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.CarouselVisible, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.PositionLabel, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource MutedTextBrush}" HorizontalAlignment="Right"/>
                <Border Width="300" Height="390" CornerRadius="8" Background="{ThemeResource SurfaceTwoBrush}"
                        BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1">
                    <Grid Padding="22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="REPS2" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="PLAYSTATION 2" FontSize="12" CharacterSpacing="45"
                                       Foreground="{ThemeResource MutedTextBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,24">
                            <Ellipse Width="196" Height="196" Stroke="{ThemeResource BorderSubtleBrush}"
                                     StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="148" Height="148" Stroke="{ThemeResource NavigationAccentBrush}"
                                     StrokeThickness="1" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="PS2" FontSize="48" FontWeight="Light" CharacterSpacing="36"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="2" Spacing="5">
                            <TextBlock Text="{x:Bind ViewModel.FeaturedTitle, Mode=OneWay}" FontSize="21"
                                       FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind ViewModel.FeaturedSerial, Mode=OneWay}" FontSize="12"
                                       FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Width="350" Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.FeaturedLifecycle, Mode=OneWay}" FontSize="15"
                               FontWeight="SemiBold" Foreground="{ThemeResource BrandBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.FeaturedEvidence, Mode=OneWay}" FontSize="13"
                               Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"
                               TextAlignment="Center" MaxLines="2"/>
                    <Button Click="CheckReadiness_Click" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Center" MinWidth="190" MinHeight="48" Margin="0,5,0,0"
                            AutomationProperties.Name="Check readiness for the selected title"
                            ToolTipService.ToolTip="Check title readiness. This does not launch a game.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="CHECK READINESS" Style="{StaticResource AccentButtonTextStyle}"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Playability unverified" Style="{StaticResource CaptionStyle}"
                               HorizontalAlignment="Center"/>
                    <Button Click="OpenTitle_Click" HorizontalAlignment="Center" MinWidth="190">
                        <TextBlock Text="Open title details"/>
                    </Button>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="3" Click="Next_Click" IsEnabled="{x:Bind ViewModel.HasMultipleGames, Mode=OneWay}"
                    VerticalAlignment="Center" Margin="18,0,0,0" MinWidth="52" MinHeight="56"
                    AutomationProperties.Name="Next title"
                    Visibility="{x:Bind ViewModel.HasMultipleGames, Mode=OneWay}" ToolTipService.ToolTip="Next title">
                <FontIcon Glyph="&#xE76C;" FontSize="20"/>
            </Button>

            <Border x:Name="NextPreviewCard" Grid.Column="4" Width="190" Height="268" CornerRadius="10" Padding="14"
                    Background="{ThemeResource SurfaceOneBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}"
                    BorderThickness="1" Opacity="0.62" VerticalAlignment="Center" HorizontalAlignment="Left"
                    Margin="20,0,0,0">
                <StackPanel VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="UP NEXT" FontSize="12" CharacterSpacing="45"
                               Foreground="{ThemeResource MutedTextBrush}"/>
                    <Border Height="138" CornerRadius="5" Background="{ThemeResource SurfaceTwoBrush}"
                            BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1">
                        <Grid>
                            <Ellipse Width="82" Height="82" Stroke="{ThemeResource BorderSubtleBrush}"
                                     StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="58" Height="58" Stroke="{ThemeResource NavigationAccentBrush}"
                                     StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="PS2" FontSize="22" FontWeight="Light" CharacterSpacing="15"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{x:Bind ViewModel.NextTitle, Mode=OneWay}" FontSize="15"
                               FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}"
                               TextWrapping="Wrap" MaxLines="2"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.ColumnSpan="5" Visibility="{x:Bind ViewModel.EmptyVisible, Mode=OneWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="520">
                <TextBlock Text="Your library is ready" FontSize="26" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Add an owner-supplied PS2 ISO from the desktop to build your collection."
                           FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"
                           TextWrapping="Wrap" TextAlignment="Center"/>
                <Button Click="Exit_Click" MinHeight="48" HorizontalAlignment="Center" Content="Return to desktop"/>
            </StackPanel>

            <StackPanel Grid.ColumnSpan="5" Visibility="{x:Bind ViewModel.ErrorVisible, Mode=OneWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="520">
                <TextBlock Text="Library could not be read" FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" FontSize="15"
                           Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <Button Click="Refresh_Click" MinHeight="48" HorizontalAlignment="Center" Content="Try again"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{ThemeResource DeepSurfaceBrush}"
                BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="28,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="← → Browse · Enter PLAY / readiness · D Details" FontSize="12"
                           Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PositionLabel, Mode=OneWay}"
                           FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Esc Back · No title is marked Boot-tested or Playable"
                           FontSize="12" Foreground="{ThemeResource MutedTextBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
