<Page
    x:Class="REPS2.Desktop.Pages.AddGamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">
    <Grid Padding="48,32" RowSpacing="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock Text="COLLECTION / ISO MANAGER" FontSize="12" FontWeight="SemiBold"
                       CharacterSpacing="45" Foreground="{ThemeResource MutedTextBrush}"/>
            <TextBlock Text="Add a game" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Bring an owner-supplied PlayStation 2 image into your library."
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{ThemeResource SurfaceOneBrush}" CornerRadius="8" Padding="20,14">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <TextBlock Text="01" Foreground="{ThemeResource NavigationAccentBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="Select image" FontSize="13"/>
                </StackPanel>
                <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="12"
                          Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <TextBlock Text="02" Foreground="{ThemeResource MutedTextBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="Inspect disc" FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}"/>
                </StackPanel>
                <FontIcon Grid.Column="3" Glyph="&#xE72A;" FontSize="12"
                          Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <TextBlock Text="03" Foreground="{ThemeResource MutedTextBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="Review evidence" FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Background="{ThemeResource InsetBrush}"
                    BorderThickness="1" Padding="32">
                <Grid>
                    <StackPanel x:Name="ImportSelectionPanel" Spacing="14" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE898;" FontSize="30" Foreground="{ThemeResource MutedTextBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Select your PS2 ISO" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Raw ISO · 2048-byte sectors · One image at a time"
                                   FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center"/>
                        <Button x:Name="BrowseButton" Click="Browse_Click" Style="{StaticResource AccentButtonStyle}"
                                MinWidth="168" Margin="0,6,0,0" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="13"/>
                                <TextBlock Text="Browse for ISO" Style="{StaticResource AccentButtonTextStyle}"/>
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="ImportStatusPanel" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" Visibility="Collapsed">
                            <ProgressRing x:Name="ImportProgressRing" Width="18" Height="18"
                                          IsActive="False"/>
                            <TextBlock Text="Inspecting the image and boot ELF…" FontSize="13"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="The original image stays in its current location."
                                   FontSize="12" Foreground="{ThemeResource MutedTextBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Border x:Name="ImportErrorPanel" Visibility="Collapsed"
                            BorderBrush="{ThemeResource DangerBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="24" MaxWidth="720"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="!" FontSize="24" FontWeight="Bold"
                                           Foreground="{ThemeResource DangerBrush}"/>
                                <TextBlock x:Name="ImportErrorTitle" Text="The image could not be inspected" FontSize="22"
                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="ImportErrorDescription" Style="{StaticResource PageSubtitleStyle}"
                                       TextWrapping="Wrap" MaxLines="4" IsTextSelectionEnabled="True"/>
                            <TextBlock x:Name="ImportErrorGuidance"
                                       Text="Choose a raw PS2 ISO with 2048-byte sectors. Compressed images and incomplete copies cannot be inspected here."
                                       Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <Button Click="RetryImport_Click" Style="{StaticResource AccentButtonStyle}">
                                    <TextBlock Text="Choose another ISO" Style="{StaticResource AccentButtonTextStyle}"/>
                                </Button>
                                <Button Click="ViewDiagnostics_Click">
                                    <TextBlock Text="View diagnostics"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="YOUR IMAGE. YOUR LIBRARY." FontSize="12" FontWeight="SemiBold"
                               CharacterSpacing="35" Foreground="{ThemeResource MutedTextBrush}"/>
                    <TextBlock Text="Evidence, not assumptions." FontSize="21" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="1   Import &amp; inspect" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Identify the disc and boot ELF." Style="{StaticResource PageSubtitleStyle}"
                                       Margin="18,0,0,0"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="2   Analyze &amp; build" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Supported instruction subsets only." Style="{StaticResource PageSubtitleStyle}"
                                       Margin="18,0,0,0"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="3   Review the result" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="A build is not proof of gameplay." Style="{StaticResource PageSubtitleStyle}"
                                       Margin="18,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="REPS2 does not distribute games, BIOS dumps, firmware or proprietary SDKs."
                   Style="{StaticResource CaptionStyle}"/>
    </Grid>
</Page>
