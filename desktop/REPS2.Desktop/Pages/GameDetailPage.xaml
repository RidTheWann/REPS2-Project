<Page
    x:Class="REPS2.Desktop.Pages.GameDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="28,24" RowSpacing="16" MaxWidth="1180" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="Game detail" Style="{StaticResource CaptionStyle}"/>
                <TextBlock x:Name="GameTitle" Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Name="GameSerial" Text="{x:Bind ViewModel.SerialLine, Mode=OneWay}" FontSize="12" FontFamily="Cascadia Mono, Consolas"
                           Foreground="{ThemeResource SecondaryTextBrush}"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{ThemeResource SurfaceTwoBrush}" Padding="16"
                            BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <Border Width="192" Height="248" CornerRadius="7"
                                    Background="{ThemeResource SurfaceOneBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="PLAYSTATION 2" FontSize="12" FontWeight="SemiBold"
                                               CharacterSpacing="45" Foreground="{ThemeResource MutedTextBrush}"
                                               Margin="12,10"/>
                                    <Grid Grid.Row="1">
                                        <Ellipse Width="128" Height="128" Stroke="{ThemeResource BorderSubtleBrush}"
                                                 StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Ellipse Width="94" Height="94" Stroke="{ThemeResource NavigationAccentBrush}"
                                                 StrokeThickness="1" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="PS2" FontSize="30" FontWeight="Light" CharacterSpacing="25"
                                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.LifecycleText, Mode=OneWay}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource BrandBrush}"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="8,4,8,12"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="Artwork is illustrative. Compatibility is determined by evidence."
                                       FontSize="12" Foreground="{ThemeResource MutedTextBrush}"
                                       TextWrapping="Wrap" MaxWidth="200"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="1" Padding="24,20,20,20" RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="READINESS &amp; PROVENANCE" FontSize="12" FontWeight="SemiBold"
                                       CharacterSpacing="35" Foreground="{ThemeResource MutedTextBrush}"/>
                            <TextBlock x:Name="LifecycleText" Text="{x:Bind ViewModel.LifecycleText, Mode=OneWay}"
                                       FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource BrandBrush}"/>
                            <TextBlock x:Name="EvidenceText" Text="{x:Bind ViewModel.EvidenceText, Mode=OneWay}"
                                       FontSize="14" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="RecoveryText" Text="{x:Bind ViewModel.RecoveryText, Mode=OneWay}"
                                       FontSize="13" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <Button Click="Readiness_Click" Style="{StaticResource AccentButtonStyle}"
                                    AutomationProperties.Name="Check readiness for this title"
                                    ToolTipService.ToolTip="Check title readiness. This does not launch a game.">
                                <TextBlock Text="CHECK READINESS" Style="{StaticResource AccentButtonTextStyle}"/>
                            </Button>
                            <Button Click="ViewIso_Click">
                                <TextBlock Text="View ISO"/>
                            </Button>
                            <Button x:Name="RelinkButton" Click="Relink_Click"
                                    Visibility="{x:Bind ViewModel.RelinkVisible, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="13"/>
                                    <TextBlock Text="Relink original ISO"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BuildButton" Click="Build_Click" Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind ViewModel.BuildVisible, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.BuildEnabled, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE943;" FontSize="13"/>
                                    <TextBlock Text="Build native module" Style="{StaticResource AccentButtonTextStyle}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ProbeButton" Click="Probe_Click"
                                    Visibility="{x:Bind ViewModel.ProbeVisible, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.ProbeEnabled, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE768;" FontSize="13"/>
                                    <TextBlock Text="Run bounded probe"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="2" Background="{ThemeResource AppBackgroundBrush}"
                                BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                                Padding="12,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Launch unavailable · No retail title is verified as Boot-tested or Playable."
                                           FontSize="13" Foreground="{ThemeResource DangerBrush}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Click="Readiness_Click">
                                    <TextBlock Text="Readiness details"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Disc identity" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="IsoPath" Text="{x:Bind ViewModel.IsoPath, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource PrimaryTextBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <TextBlock Text="ISO SHA-256" Style="{StaticResource CaptionStyle}"/>
                        <TextBlock x:Name="IsoDigest" Text="{x:Bind ViewModel.IsoDigest, Mode=OneWay}" Style="{StaticResource MonoTextStyle}"/>
                        <TextBlock Text="Boot ELF entry" Style="{StaticResource CaptionStyle}"/>
                        <TextBlock x:Name="EntryPoint" Text="{x:Bind ViewModel.EntryPoint, Mode=OneWay}" FontSize="12" FontFamily="Cascadia Mono, Consolas"
                                   Foreground="{ThemeResource SecondaryTextBrush}"/>
                        <TextBlock Text="Source policy" Style="{StaticResource CaptionStyle}"/>
                        <TextBlock Text="Original ISO stays external" FontSize="12"
                                   Foreground="{ThemeResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Analysis coverage" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="BlocksValue" Text="{x:Bind ViewModel.BlocksValue, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PrimaryTextBrush}"/>
                        <TextBlock Text="Basic blocks" Style="{StaticResource CaptionStyle}"/>
                        <TextBlock x:Name="InstructionsValue" Text="{x:Bind ViewModel.InstructionsValue, Mode=OneWay}" FontSize="16"
                                   Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="Decoded guest instructions" Style="{StaticResource CaptionStyle}"/>
                        <TextBlock x:Name="UnsupportedValue" Text="{x:Bind ViewModel.UnsupportedLine, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="7">
                    <TextBlock Text="Native build identity" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="BuildStateText" Text="{x:Bind ViewModel.BuildStateText, Mode=OneWay}" FontSize="13"
                               Foreground="{ThemeResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="BuildCacheKey" Text="{x:Bind ViewModel.BuildCacheKey, Mode=OneWay}" Style="{StaticResource MonoTextStyle}"/>
                    <TextBlock x:Name="BuildModulePath" Text="{x:Bind ViewModel.BuildModulePath, Mode=OneWay}" Style="{StaticResource CaptionStyle}"
                               IsTextSelectionEnabled="True"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Alpha limitations" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Text="Imported, analyzed, translated and native-built are separate evidence states."
                               FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="A successful C++ build or bounded runner exit does not prove a game booted."
                               FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="REPS2 never marks a title Playable automatically; a documented gameplay plan must pass first."
                               FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>