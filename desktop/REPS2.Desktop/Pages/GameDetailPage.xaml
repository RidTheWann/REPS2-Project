<Page
    x:Class="REPS2.Desktop.Pages.GameDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="28,24" RowSpacing="16" MaxWidth="1180" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="Game detail" Style="{StaticResource CaptionStyle}"/>
                <TextBlock x:Name="GameTitle" Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Name="GameSerial" Text="{x:Bind ViewModel.SerialLine, Mode=OneWay}" FontSize="12" FontFamily="Cascadia Mono, Consolas"
                           Foreground="{ThemeResource SecondaryTextBrush}"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Compatibility state" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="LifecycleText" Text="{x:Bind ViewModel.LifecycleText, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{ThemeResource BrandBrush}"/>
                        <TextBlock x:Name="EvidenceText" Text="{x:Bind ViewModel.EvidenceText, Mode=OneWay}" FontSize="13"
                                   Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="RecoveryText" Text="{x:Bind ViewModel.RecoveryText, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" MinWidth="196">
                        <Button x:Name="RelinkButton" Click="Relink_Click" Visibility="{x:Bind ViewModel.RelinkVisible, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE8B7;" FontSize="13"/>
                                <TextBlock Text="Relink original ISO"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BuildButton" Click="Build_Click" Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind ViewModel.BuildVisible, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.BuildEnabled, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE943;" FontSize="13"/>
                                <TextBlock Text="Build native module"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ProbeButton" Click="Probe_Click"
                                Visibility="{x:Bind ViewModel.ProbeVisible, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.ProbeEnabled, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE768;" FontSize="13"/>
                                <TextBlock Text="Run bounded probe"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Play is unavailable until gameplay acceptance passes."
                                   Style="{StaticResource CaptionStyle}" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Disc identity" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="IsoPath" Text="{x:Bind ViewModel.IsoPath, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource PrimaryTextBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <TextBlock Text="ISO SHA-256" Style="{StaticResource CaptionStyle}"/>
                        <TextBlock x:Name="IsoDigest" Text="{x:Bind ViewModel.IsoDigest, Mode=OneWay}" Style="{StaticResource MonoTextStyle}"/>
                        <TextBlock Text="Boot ELF entry" Style="{StaticResource CaptionStyle}"/>
                        <TextBlock x:Name="EntryPoint" Text="{x:Bind ViewModel.EntryPoint, Mode=OneWay}" FontSize="12" FontFamily="Cascadia Mono, Consolas"
                                   Foreground="{ThemeResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Analysis coverage" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="BlocksValue" Text="{x:Bind ViewModel.BlocksValue, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PrimaryTextBrush}"/>
                        <TextBlock Text="Basic blocks" Style="{StaticResource CaptionStyle}"/>
                        <TextBlock x:Name="InstructionsValue" Text="{x:Bind ViewModel.InstructionsValue, Mode=OneWay}" FontSize="16"
                                   Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="Decoded guest instructions" Style="{StaticResource CaptionStyle}"/>
                        <TextBlock x:Name="UnsupportedValue" Text="{x:Bind ViewModel.UnsupportedLine, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="7">
                    <TextBlock Text="Native build identity" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="BuildStateText" Text="{x:Bind ViewModel.BuildStateText, Mode=OneWay}" FontSize="13"
                               Foreground="{ThemeResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="BuildCacheKey" Text="{x:Bind ViewModel.BuildCacheKey, Mode=OneWay}" Style="{StaticResource MonoTextStyle}"/>
                    <TextBlock x:Name="BuildModulePath" Text="{x:Bind ViewModel.BuildModulePath, Mode=OneWay}" Style="{StaticResource CaptionStyle}"
                               IsTextSelectionEnabled="True"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Alpha limitations" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Text="Imported, analyzed, translated and native-built are separate evidence states."
                               FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="A successful C++ build or bounded runner exit does not prove a game booted."
                               FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="REPS2 never marks a title Playable automatically; a documented gameplay plan must pass first."
                               FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>