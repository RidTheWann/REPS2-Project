<Page
    x:Class="REPS2.Desktop.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">
    <Grid x:Name="PageRoot" Padding="36,28,36,24" RowSpacing="18" IsTabStop="True"
          KeyDown="PageRoot_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="YOUR COLLECTION" FontSize="12" FontWeight="SemiBold"
                           CharacterSpacing="60" Foreground="{ThemeResource MutedTextBrush}"/>
                <TextBlock Text="A new home for your classics." Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Your library, one focused place. Add a lawfully owned PS2 ISO to get started."
                           Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.CollectionCount, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource MutedTextBrush}"
                           VerticalAlignment="Center"/>
                <Button Click="Refresh_Click" ToolTipService.ToolTip="Refresh library">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid x:Name="Carousel" Visibility="{x:Bind ViewModel.CarouselVisible, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="170" Height="230" CornerRadius="8" Padding="16"
                        Background="{ThemeResource SurfaceOneBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}"
                        BorderThickness="1" Opacity="0.62" VerticalAlignment="Center" HorizontalAlignment="Right"
                        Margin="0,0,20,0" Visibility="{x:Bind ViewModel.HasMultipleGames, Mode=OneWay}">
                    <StackPanel VerticalAlignment="Center" Spacing="12">
                        <TextBlock Text="PREVIOUS" FontSize="12" CharacterSpacing="45"
                                   Foreground="{ThemeResource MutedTextBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.PreviousTitle, Mode=OneWay}" FontSize="17"
                                   FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" MaxLines="4"/>
                    </StackPanel>
                </Border>
                <Button Grid.Column="1" Click="Previous_Click" IsEnabled="{x:Bind ViewModel.HasMultipleGames, Mode=OneWay}"
                        VerticalAlignment="Center" Margin="0,0,18,0" ToolTipService.ToolTip="Previous title"
                        Visibility="{x:Bind ViewModel.HasMultipleGames, Mode=OneWay}">
                    <FontIcon Glyph="&#xE76B;" FontSize="16"/>
                </Button>

                <StackPanel Grid.Column="2" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="276" Height="280" CornerRadius="6" Background="{ThemeResource SurfaceTwoBrush}"
                            BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1">
                        <Grid Padding="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="REPS2" FontSize="13" FontWeight="Bold"
                                           Foreground="{ThemeResource PrimaryTextBrush}"/>
                                <TextBlock Text="PLAYSTATION 2" FontSize="12" CharacterSpacing="40"
                                           Foreground="{ThemeResource MutedTextBrush}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,20">
                                <Ellipse Width="150" Height="150" Stroke="{ThemeResource BorderSubtleBrush}"
                                         StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Width="112" Height="112" Stroke="{ThemeResource NavigationAccentBrush}"
                                         StrokeThickness="1" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="PS2" FontSize="38" FontWeight="Light" CharacterSpacing="30"
                                           Foreground="{ThemeResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Row="2" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.FeaturedTitle, Mode=OneWay}" FontSize="19"
                                           FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind ViewModel.FeaturedSerial, Mode=OneWay}" FontSize="12"
                                           FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource MutedTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Width="330" Spacing="5" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.FeaturedLifecycle, Mode=OneWay}" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{ThemeResource BrandBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.FeaturedEvidence, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxLines="2"/>
                        <Button Click="OpenTitle_Click" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Center" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="Open title"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="3" Click="Next_Click" IsEnabled="{x:Bind ViewModel.HasMultipleGames, Mode=OneWay}"
                        VerticalAlignment="Center" Margin="18,0,0,0" ToolTipService.ToolTip="Next title"
                        Visibility="{x:Bind ViewModel.HasMultipleGames, Mode=OneWay}">
                    <FontIcon Glyph="&#xE76C;" FontSize="16"/>
                </Button>
                <Border Grid.Column="4" Width="170" Height="230" CornerRadius="8" Padding="16"
                        Background="{ThemeResource SurfaceOneBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}"
                        BorderThickness="1" Opacity="0.62" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Margin="20,0,0,0" Visibility="{x:Bind ViewModel.HasMultipleGames, Mode=OneWay}">
                    <StackPanel VerticalAlignment="Center" Spacing="12">
                        <TextBlock Text="UP NEXT" FontSize="12" CharacterSpacing="45"
                                   Foreground="{ThemeResource MutedTextBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.NextTitle, Mode=OneWay}" FontSize="17"
                                   FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" MaxLines="4"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel x:Name="EmptyState" Visibility="{x:Bind ViewModel.EmptyVisible, Mode=OneWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="14">
                <Border Width="64" Height="64" CornerRadius="18" Background="{ThemeResource SurfaceTwoBrush}"
                        HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE7FC;" FontSize="26" Foreground="{ThemeResource NavigationAccentBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Your library is ready" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Add one raw PS2 ISO you own. REPS2 validates it and leaves the source file untouched."
                           Style="{StaticResource PageSubtitleStyle}" TextAlignment="Center"/>
                <Button Click="AddGame_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE710;" FontSize="13"/>
                        <TextBlock Text="Add your first game"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel x:Name="ErrorState" Visibility="{x:Bind ViewModel.ErrorVisible, Mode=OneWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Spacing="10">
                <TextBlock Text="Library could not be read" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}"
                           TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                <Button Click="Refresh_Click" HorizontalAlignment="Center" Content="Try again"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{ThemeResource SurfaceOneBrush}"
                BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="A truthful view of an experimental platform" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="A successful import or native build does not prove a title boots or is playable."
                           Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.PositionLabel, Mode=OneWay}"
                           Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
