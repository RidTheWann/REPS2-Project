<Page
    x:Class="REPS2.Desktop.Pages.ReadinessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">
    <Grid Padding="48,32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock Text="LAUNCH / READINESS" FontSize="12" FontWeight="SemiBold"
                       CharacterSpacing="45" Foreground="{ThemeResource MutedTextBrush}"/>
            <TextBlock Text="Before the game begins." Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Readiness is checked against evidence first. This screen does not launch a game."
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" MaxWidth="1020"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
            <Grid ColumnSpacing="28" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Width="190" Height="248" CornerRadius="7" Background="{ThemeResource SurfaceTwoBrush}"
                        VerticalAlignment="Top">
                    <Grid Padding="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="PLAYSTATION 2" FontSize="12" FontWeight="SemiBold"
                                   CharacterSpacing="40" Foreground="{ThemeResource MutedTextBrush}"/>
                        <Grid Grid.Row="1">
                            <Ellipse Width="128" Height="128" Stroke="{ThemeResource BorderSubtleBrush}"
                                     StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="94" Height="94" Stroke="{ThemeResource NavigationAccentBrush}"
                                     StrokeThickness="1" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="PS2" FontSize="30" FontWeight="Light" CharacterSpacing="25"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.Lifecycle, Mode=OneWay}" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{ThemeResource BrandBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="25"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind ViewModel.SerialLine, Mode=OneWay}" FontSize="12"
                               FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource MutedTextBrush}"/>
                    <TextBlock Text="Launch unavailable" FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource DangerBrush}" Margin="0,6,0,0"/>
                    <TextBlock Text="No retail PS2 title is currently verified as Boot-tested or Playable. A successful import, analysis, native build, or bounded probe does not establish gameplay."
                               Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
                    <Border BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                            Margin="0,8,0,0" Padding="0,8,0,0">
                        <Grid ColumnSpacing="16" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Original image" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SourceImage, Mode=OneWay}" FontSize="13"/>
                            <TextBlock Grid.Row="1" Text="Native title module" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.NativeModule, Mode=OneWay}"
                                       FontSize="13"/>
                            <TextBlock Grid.Row="2" Text="Boot / gameplay evidence" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.BootEvidence, Mode=OneWay}"
                                       FontSize="13"/>
                            <TextBlock Grid.Row="3" Text="Source policy" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SourcePolicy}"
                                       FontSize="13"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Click="ViewDetails_Click" Style="{StaticResource AccentButtonStyle}">
                        <TextBlock Text="View game details" Style="{StaticResource AccentButtonTextStyle}"/>
                    </Button>
                    <Button Grid.Column="1" Click="OpenDeveloper_Click">
                        <TextBlock Text="Open diagnostics"/>
                    </Button>
                    <Button Grid.Column="3" Click="ReturnHome_Click">
                        <TextBlock Text="Return home"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="Experimental AOT foundation · No performance or compatibility claim"
                   Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center"/>
    </Grid>
</Page>
