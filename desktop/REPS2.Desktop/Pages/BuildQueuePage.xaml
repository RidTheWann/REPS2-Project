<Page
    x:Class="REPS2.Desktop.Pages.BuildQueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:REPS2.Desktop.Api.Contracts"
    Background="{ThemeResource AppBackgroundBrush}">
    <Grid Padding="28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Build queue" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Persisted native-build jobs. Stage changes are reported at real process boundaries, never as invented percentages."
                           Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <Button Grid.Column="1" Click="Refresh_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
        </Grid>
        <TextBlock x:Name="QueueSummary" Grid.Row="1" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource CaptionStyle}"/>
        <Grid Grid.Row="2">
            <ListView x:Name="JobsList" ItemsSource="{x:Bind ViewModel.Jobs}" Visibility="{x:Bind ViewModel.JobsVisible, Mode=OneWay}"
                      SelectionMode="None" Background="Transparent" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:JobRecord">
                        <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,10">
                            <Grid ColumnSpacing="18" RowSpacing="8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind GameName}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource PrimaryTextBrush}"/>
                                    <TextBlock Text="{x:Bind JobId}" FontSize="10" FontFamily="Cascadia Mono, Consolas"
                                               Foreground="{ThemeResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Stage" Style="{StaticResource CaptionStyle}"/>
                                    <TextBlock Text="{x:Bind Stage}" FontSize="12"
                                               Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Status" Style="{StaticResource CaptionStyle}"/>
                                    <TextBlock Text="{x:Bind Status}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource BrandBrush}"/>
                                    <TextBlock Text="{x:Bind ExitCodeLabel}" FontSize="10"
                                               Foreground="{ThemeResource MutedTextBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="6" MinWidth="112">
                                    <TextBlock Text="{x:Bind UpdatedLabel}" FontSize="10"
                                               Foreground="{ThemeResource MutedTextBrush}" TextAlignment="Right"/>
                                    <Button Content="Open output" Tag="{x:Bind OutputDirectory}"
                                            IsEnabled="{x:Bind HasOutputDirectory}" Click="OpenDirectory_Click"
                                            Padding="8,4" MinHeight="28" FontSize="11"/>
                                    <Button Content="Open logs" Tag="{x:Bind DiagnosticsDirectory}"
                                            IsEnabled="{x:Bind HasDiagnosticsDirectory}" Click="OpenDirectory_Click"
                                            Padding="8,4" MinHeight="28" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Bind Message}" FontSize="11"
                                           Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" MaxLines="2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                           Text="{x:Bind OutputDirectory}" FontSize="10"
                                           FontFamily="Cascadia Mono, Consolas"
                                           Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" MaxLines="2"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyJobs" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="400"
                        Visibility="{x:Bind ViewModel.EmptyVisible, Mode=OneWay}">
                <FontIcon Glyph="&#xE823;" FontSize="26" Foreground="{ThemeResource MutedTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="No build jobs yet" FontSize="18" FontWeight="SemiBold"
                           Foreground="{ThemeResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Open an analyzed game and prepare its native module to create the first job."
                           Style="{StaticResource PageSubtitleStyle}" TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>