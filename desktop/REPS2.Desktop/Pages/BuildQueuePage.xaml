<Page
    x:Class="REPS2.Desktop.Pages.BuildQueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:REPS2.Desktop.Core.Models"
    Background="{StaticResource AppBackgroundBrush}">
    <Grid Padding="30" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="5">
            <TextBlock Text="Build Queue" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
            <TextBlock Text="Persisted native-build jobs. Stage changes are shown at real process boundaries, never as invented percentage progress." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="QueueSummary" Text="No jobs recorded" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE72C;" FontSize="13"/><TextBlock Text="Refresh"/></StackPanel>
            </Button>
        </Grid>
        <Grid Grid.Row="2">
            <ListView x:Name="JobsList" SelectionMode="None" Background="Transparent" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:JobRecord">
                        <Border Background="{StaticResource SurfaceOneBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,0,0,10">
                            <Grid ColumnSpacing="18" RowSpacing="7">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{x:Bind GameName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Text="{x:Bind JobId}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="STAGE" FontSize="9" CharacterSpacing="100" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="{x:Bind Stage}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Text="STATUS" FontSize="9" CharacterSpacing="100" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="{x:Bind Status}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"/>
                                    <TextBlock Text="{x:Bind ExitCodeLabel}" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="6" MinWidth="108">
                                    <TextBlock Text="{x:Bind UpdatedLabel}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Right"/>
                                    <Button Content="Open output" Tag="{x:Bind OutputDirectory}" IsEnabled="{x:Bind HasOutputDirectory}" Click="OpenDirectory_Click" Padding="8,5" MinHeight="28"/>
                                    <Button Content="Open logs" Tag="{x:Bind DiagnosticsDirectory}" IsEnabled="{x:Bind HasDiagnosticsDirectory}" Click="OpenDirectory_Click" Padding="8,5" MinHeight="28"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Bind Message}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" MaxLines="2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind OutputDirectory}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" MaxLines="2"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyJobs" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE823;" FontSize="32" Foreground="{StaticResource BrandBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="No build jobs yet" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Open an analyzed game and prepare its native module to create the first job." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
