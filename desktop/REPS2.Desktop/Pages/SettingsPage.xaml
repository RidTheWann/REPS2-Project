<Page
    x:Class="REPS2.Desktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="30" MaxWidth="950" RowSpacing="18" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Spacing="5">
                <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="Configure the installed REPS2 developer SDK. The library remains offline-first." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>
            <Border Grid.Row="1" Background="{StaticResource SurfaceOneBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="GAME LIBRARY" FontSize="11" CharacterSpacing="100" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBox x:Name="LibraryRootBox" PlaceholderText="%LOCALAPPDATA%\REPS2\Library"/>
                    <TextBlock Text="The source ISO is referenced at its original location. REPS2 stores validated metadata and derived artifacts in this library." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Background="{StaticResource SurfaceOneBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="9">
                    <TextBlock Text="REPS2 TOOLCHAIN" FontSize="11" CharacterSpacing="100" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Text="Frontend executable (reps2.exe)" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBox x:Name="FrontendPathBox" PlaceholderText="Auto-detected from tools\bin or LocalAppData"/>
                    <TextBlock Text="Engine runner (rg-reps2-engine.exe)" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBox x:Name="RunnerPathBox" PlaceholderText="Auto-detected from tools\bin or LocalAppData"/>
                    <TextBlock Text="SDK include root (contains reps2\runtime and rg_reps2_engine)" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBox x:Name="SdkIncludeRootBox" PlaceholderText="Portable SDK\include"/>
                    <TextBlock Text="CMake executable" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBox x:Name="CMakePathBox" PlaceholderText="Auto-detected from PATH"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="3" Background="{StaticResource SurfaceOneBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="NATIVE BUILD &amp; PROBE" FontSize="11" CharacterSpacing="100" Foreground="{StaticResource MutedTextBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Translation units" Width="180" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <ComboBox x:Name="TuCountBox" Width="120">
                            <ComboBoxItem Content="2" Tag="2"/><ComboBoxItem Content="4" Tag="4"/>
                            <ComboBoxItem Content="8" Tag="8"/><ComboBoxItem Content="16" Tag="16"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Probe instruction budget" Width="180" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <ComboBox x:Name="ProbeBudgetBox" Width="160">
                            <ComboBoxItem Content="1 million" Tag="1000000"/>
                            <ComboBoxItem Content="5 million" Tag="5000000"/>
                            <ComboBoxItem Content="10 million" Tag="10000000"/>
                            <ComboBoxItem Content="25 million" Tag="25000000"/>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="DiagnosticsCheckBox" Content="Enable structured developer diagnostics for import and build commands" Foreground="{StaticResource PrimaryTextBrush}"/>
                    <CheckBox x:Name="AutoCheckUpdatesCheckBox" Content="Automatically check for REPS2 Desktop Alpha updates on startup" Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock Text="When an update is found, the header button becomes Update now. REPS2 downloads and verifies the package, restarts through its helper, and rolls back if the new version does not complete startup." FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="Native compilation requires CMake and a Visual Studio C++ toolchain. The runner executes trusted native code with the current user's privileges; it is not a sandbox." FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10">
                <Button Click="Save_Click" Background="{StaticResource BrandBrush}" Foreground="#0A0F1C" BorderThickness="0" FontWeight="SemiBold">Save settings</Button>
                <Button Click="Reset_Click">Reset defaults</Button>
            </StackPanel>
            <TextBlock x:Name="SettingsStatus" Grid.Row="5" Text="Settings are stored locally." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
        </Grid>
    </ScrollViewer>
</Page>
