<Page
    x:Class="REPS2.Desktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,24" Spacing="16" MaxWidth="960" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Configure the installed REPS2 developer SDK. The library remains offline-first."
                           Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Game library" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBox x:Name="LibraryRootBox" PlaceholderText="%LOCALAPPDATA%\REPS2\Library"/>
                    <TextBlock Text="The source ISO stays at its original location. REPS2 stores validated metadata and derived artifacts in this library."
                               Style="{StaticResource CaptionStyle}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="REPS2 toolchain" Style="{StaticResource SectionLabelStyle}"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Frontend executable (reps2.exe)" Style="{StaticResource CaptionStyle}"/>
                        <TextBox x:Name="FrontendPathBox" PlaceholderText="Auto-detected from tools\bin or LocalAppData"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Engine runner (rg-reps2-engine.exe)" Style="{StaticResource CaptionStyle}"/>
                        <TextBox x:Name="RunnerPathBox" PlaceholderText="Auto-detected from tools\bin or LocalAppData"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="SDK include root (contains reps2\runtime and rg_reps2_engine)" Style="{StaticResource CaptionStyle}"/>
                        <TextBox x:Name="SdkIncludeRootBox" PlaceholderText="Portable SDK\include"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="CMake executable" Style="{StaticResource CaptionStyle}"/>
                        <TextBox x:Name="CMakePathBox" PlaceholderText="Auto-detected from PATH"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Native build and probe" Style="{StaticResource SectionLabelStyle}"/>
                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Translation units" VerticalAlignment="Center"
                                   Foreground="{ThemeResource SecondaryTextBrush}"/>
                        <ComboBox x:Name="TuCountBox" Grid.Column="1" Width="120">
                            <ComboBoxItem Content="2" Tag="2"/><ComboBoxItem Content="4" Tag="4"/>
                            <ComboBoxItem Content="8" Tag="8"/><ComboBoxItem Content="16" Tag="16"/>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Text="Probe instruction budget" VerticalAlignment="Center"
                                   Foreground="{ThemeResource SecondaryTextBrush}"/>
                        <ComboBox x:Name="ProbeBudgetBox" Grid.Row="1" Grid.Column="1" Width="150">
                            <ComboBoxItem Content="1 million" Tag="1000000"/>
                            <ComboBoxItem Content="5 million" Tag="5000000"/>
                            <ComboBoxItem Content="10 million" Tag="10000000"/>
                            <ComboBoxItem Content="25 million" Tag="25000000"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="DiagnosticsCheckBox" Content="Enable structured developer diagnostics for import and build commands"/>
                    <CheckBox x:Name="AutoCheckUpdatesCheckBox" Content="Automatically check for Desktop Alpha updates on startup"/>
                    <TextBlock Text="When an update is found, the header button becomes Update now. REPS2 verifies the package, restarts through its helper, and rolls back if the new version fails to start."
                               Style="{StaticResource CaptionStyle}"/>
                    <TextBlock Text="Native compilation requires CMake and a Visual Studio C++ toolchain. The runner executes trusted native code with the current user's privileges; it is not a sandbox."
                               Style="{StaticResource CaptionStyle}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="Save_Click" Style="{StaticResource AccentButtonStyle}" Content="Save settings"/>
                <Button Click="Reset_Click" Content="Reset defaults"/>
            </StackPanel>
            <TextBlock x:Name="SettingsStatus" Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       Style="{StaticResource CaptionStyle}"/>
        </StackPanel>
    </ScrollViewer>
</Page>