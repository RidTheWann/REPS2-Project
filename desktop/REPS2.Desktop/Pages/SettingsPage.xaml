<Page
    x:Class="REPS2.Desktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">
    <Grid Padding="64,32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="APPLICATION / PREFERENCES" FontSize="12" FontWeight="SemiBold"
                       CharacterSpacing="45" Foreground="{ThemeResource MutedTextBrush}"/>
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="A focused setup for your desktop and your collection."
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{ThemeResource DeepSurfaceBrush}" CornerRadius="8" Padding="12">
                <StackPanel Spacing="4">
                    <Button x:Name="GeneralCategoryButton" Tag="General" Click="Category_Click"
                            HorizontalContentAlignment="Left" MinHeight="48" Background="{ThemeResource SurfaceTwoBrush}">
                        <TextBlock Text="General"/>
                    </Button>
                    <Button x:Name="LibraryCategoryButton" Tag="Library" Click="Category_Click"
                            HorizontalContentAlignment="Left" MinHeight="48" Background="Transparent">
                        <TextBlock Text="Library &amp; storage"/>
                    </Button>
                    <Button x:Name="ControllerCategoryButton" Tag="Controller" Click="Category_Click"
                            HorizontalContentAlignment="Left" MinHeight="48" Background="Transparent">
                        <TextBlock Text="Controller guide"/>
                    </Button>
                    <Button x:Name="AdvancedCategoryButton" Tag="Advanced" Click="Category_Click"
                            HorizontalContentAlignment="Left" MinHeight="48" Background="Transparent">
                        <TextBlock Text="Advanced"/>
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource DeepSurfaceBrush}" CornerRadius="8"
                    Padding="28,24">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <StackPanel x:Name="GeneralPanel" Spacing="0">
                            <TextBlock Text="General" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <Grid ColumnSpacing="20" Margin="0,8,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="184"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Appearance" FontSize="14"/>
                                    <TextBlock Text="Choose dark graphite or light appearance" Style="{StaticResource CaptionStyle}"/>
                                </StackPanel>
                                <ComboBox x:Name="ThemeBox" Grid.Column="1" VerticalAlignment="Center" SelectedIndex="0">
                                    <ComboBoxItem Content="Dark" Tag="Dark"/>
                                    <ComboBoxItem Content="Light" Tag="Light"/>
                                </ComboBox>
                            </Grid>
                            <Border BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0"/>
                            <Grid ColumnSpacing="20" Margin="0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Reduce motion" FontSize="14"/>
                                    <TextBlock Text="Replace transitions with immediate state changes" Style="{StaticResource CaptionStyle}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ReduceMotionSwitch" Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                            <Border BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0"/>
                            <Grid ColumnSpacing="20" Margin="0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Confirm before exit" FontSize="14"/>
                                    <TextBlock Text="Ask before closing the desktop experience" Style="{StaticResource CaptionStyle}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ConfirmExitSwitch" Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                            <Border BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0"/>
                            <Grid ColumnSpacing="20" Margin="0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="184"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Updates" FontSize="14"/>
                                    <TextBlock x:Name="UpdateStatusLabel" Text="Desktop Alpha · Check published releases"
                                               Style="{StaticResource CaptionStyle}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Click="CheckUpdates_Click" Content="Check updates"
                                        VerticalAlignment="Center"/>
                            </Grid>
                            <Border BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0"/>
                            <Grid ColumnSpacing="20" Margin="0,14,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="184"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Developer tools" FontSize="14"/>
                                    <TextBlock Text="Logs, diagnostics and artifact inspection" Style="{StaticResource CaptionStyle}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Click="OpenDeveloper_Click" Content="Open tools"
                                        VerticalAlignment="Center"/>
                            </Grid>
                            </StackPanel>

                            <StackPanel x:Name="LibraryPanel" Spacing="14" Visibility="Collapsed">
                                <TextBlock Text="Library &amp; storage" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="Choose where REPS2 stores validated metadata and derived artifacts."
                                           Style="{StaticResource PageSubtitleStyle}"/>
                                <TextBox x:Name="LibraryRootBox" PlaceholderText="%LOCALAPPDATA%\REPS2\Library"/>
                                <TextBlock Text="Your original ISO stays in its current location. REPS2 never moves or modifies it."
                                           Style="{StaticResource CaptionStyle}"/>
                                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="OWNER-SUPPLIED IMAGES" Style="{StaticResource SectionLabelStyle}"/>
                                        <TextBlock Text="One raw PS2 ISO at a time · 2048-byte sectors · Local-first storage"
                                                   Style="{StaticResource PageSubtitleStyle}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="ControllerPanel" Spacing="16" Visibility="Collapsed">
                                <TextBlock Text="Controller guide" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="Browse the desktop with a keyboard. Gamepad navigation is not available in this build."
                                           Style="{StaticResource PageSubtitleStyle}"/>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="DESKTOP" Style="{StaticResource SectionLabelStyle}"/>
                                        <TextBlock Text="← / →   Browse the selected title"/>
                                        <TextBlock Text="Enter   Check title readiness"/>
                                        <TextBlock Text="Tab   Move through available actions"/>
                                        <TextBlock Text="F11   Enter or leave Big Picture"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="BIG PICTURE" Style="{StaticResource SectionLabelStyle}"/>
                                        <TextBlock Text="← / →   Browse titles"/>
                                        <TextBlock Text="Enter   Check title readiness"/>
                                        <TextBlock Text="D   Open title details"/>
                                        <TextBlock Text="Esc / F11   Exit Big Picture"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="AdvancedPanel" Spacing="14" Visibility="Collapsed">
                                <TextBlock Text="Advanced" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="Configure the installed REPS2 developer SDK and bounded build tools."
                                           Style="{StaticResource PageSubtitleStyle}"/>
                                <TextBlock Text="Frontend executable (reps2.exe)" Style="{StaticResource CaptionStyle}"/>
                                <TextBox x:Name="FrontendPathBox" PlaceholderText="Auto-detected from tools\bin or LocalAppData"/>
                                <TextBlock Text="Engine runner (rg-reps2-engine.exe)" Style="{StaticResource CaptionStyle}"/>
                                <TextBox x:Name="RunnerPathBox" PlaceholderText="Auto-detected from tools\bin or LocalAppData"/>
                                <TextBlock Text="SDK include root" Style="{StaticResource CaptionStyle}"/>
                                <TextBox x:Name="SdkIncludeRootBox" PlaceholderText="Portable SDK\include"/>
                                <TextBlock Text="CMake executable" Style="{StaticResource CaptionStyle}"/>
                                <TextBox x:Name="CMakePathBox" PlaceholderText="Auto-detected from PATH"/>
                                <Grid ColumnSpacing="12" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Translation units" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="TuCountBox" Grid.Column="1" Width="120">
                                        <ComboBoxItem Content="2" Tag="2"/><ComboBoxItem Content="4" Tag="4"/>
                                        <ComboBoxItem Content="8" Tag="8"/><ComboBoxItem Content="16" Tag="16"/>
                                    </ComboBox>
                                    <TextBlock Grid.Column="3" Text="Probe instruction budget" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ProbeBudgetBox" Grid.Column="4" Width="150">
                                        <ComboBoxItem Content="1 million" Tag="1000000"/>
                                        <ComboBoxItem Content="5 million" Tag="5000000"/>
                                        <ComboBoxItem Content="10 million" Tag="10000000"/>
                                        <ComboBoxItem Content="25 million" Tag="25000000"/>
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="DiagnosticsCheckBox"
                                          Content="Enable structured developer diagnostics for import and build commands"/>
                                <TextBlock Text="Native code runs with the current user's privileges. The RG REPS2 ENGINE runner is not a sandbox."
                                           Style="{StaticResource CaptionStyle}"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SettingsStatus" Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Click="Reset_Click" Content="Reset defaults"/>
                            <Button Click="Save_Click" Style="{StaticResource AccentButtonStyle}" Content="Save settings"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
