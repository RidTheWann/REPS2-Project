<Page
    x:Class="REPS2.Desktop.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">
    <Grid Padding="64,42" RowSpacing="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="12">
            <TextBlock Text="REPS2" FontSize="42" FontWeight="Bold"
                       CharacterSpacing="16"/>
            <TextBlock Text="A new home for your classics." FontSize="32"
                       FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="DESKTOP EXPERIENCE / EXPERIMENTAL PLATFORM" FontSize="12"
                       CharacterSpacing="40" Foreground="{ThemeResource NavigationAccentBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="24">
                <Grid RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="01" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{ThemeResource NavigationAccentBrush}"/>
                        <TextBlock Text="Browse" FontSize="21" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="16">
                        <TextBlock Text="One focused home. Your actual collection, never sample titles."
                                   Style="{StaticResource PageSubtitleStyle}"/>
                        <Border Height="128" CornerRadius="7" Background="{ThemeResource SurfaceTwoBrush}"
                                BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Ellipse Width="82" Height="82" Stroke="{ThemeResource NavigationAccentBrush}"
                                         StrokeThickness="1" HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="PS2" FontSize="28" FontWeight="Light" CharacterSpacing="18"
                                           Foreground="{ThemeResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="YOUR LIBRARY" FontSize="10" CharacterSpacing="38"
                                           Foreground="{ThemeResource MutedTextBrush}"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Margin="14,12,0,0"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="Browse titles and inspect evidence before taking action."
                                   Style="{StaticResource PageSubtitleStyle}"/>
                    </StackPanel>
                    <Button Grid.Row="2" Click="ExploreDesktop_Click" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Left" MinWidth="150">
                        <TextBlock Text="Explore desktop" Style="{StaticResource AccentButtonTextStyle}"/>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="24">
                <Grid RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="02" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{ThemeResource NavigationAccentBrush}"/>
                        <TextBlock Text="Manage" FontSize="21" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="12">
                        <TextBlock Text="Library, ISO import, profile and settings."
                                   Style="{StaticResource PageSubtitleStyle}"/>
                        <TextBlock Text="Trophies and gameplay statistics appear only when supported by real evidence."
                                   Style="{StaticResource PageSubtitleStyle}"/>
                        <Border BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                                Padding="0,12,0,0" Margin="0,4,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="OWNER-SUPPLIED IMAGES" FontSize="11" FontWeight="SemiBold"
                                           CharacterSpacing="24" Foreground="{ThemeResource MutedTextBrush}"/>
                                <TextBlock Text="Your original ISO stays in its current location."
                                           Style="{StaticResource PageSubtitleStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Button Grid.Row="2" Click="EnterBigPicture_Click" HorizontalAlignment="Left"
                            MinWidth="150">
                        <TextBlock Text="Enter Big Picture"/>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="24">
                <Grid RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="03" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{ThemeResource NavigationAccentBrush}"/>
                        <TextBlock Text="System evidence" FontSize="21" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="14">
                        <TextBlock Text="Inspect engine reports and diagnostics without inventing performance."
                                   Style="{StaticResource PageSubtitleStyle}"/>
                        <Border Background="{ThemeResource InsetBrush}" CornerRadius="7" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="RUNTIME" FontSize="11" FontWeight="SemiBold"
                                           CharacterSpacing="30" Foreground="{ThemeResource MutedTextBrush}"/>
                                <TextBlock Text="No active session" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Reports are shown when an actual run produces one."
                                           Style="{StaticResource CaptionStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Button Grid.Row="2" Click="OpenSystem_Click" HorizontalAlignment="Left" MinWidth="150">
                        <TextBlock Text="Open system monitor"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="A truthful view of an experimental platform" FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock Text="No retail title is currently verified as Boot-tested or Playable. Readiness is evidence-gated; import, native builds and bounded probes do not prove gameplay."
                       Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
            <TextBlock Text="Game artwork is not included. Browse and Big Picture use original REPS2 placeholder artwork until you add your own titles."
                       Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Page>
