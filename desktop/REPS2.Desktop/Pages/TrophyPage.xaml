<Page
    x:Class="REPS2.Desktop.Pages.TrophyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:REPS2.Desktop.Api.Contracts"
    Background="{ThemeResource AppBackgroundBrush}">
    <Grid Padding="48,32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock Text="PLAYER / TROPHY" FontSize="12" FontWeight="SemiBold"
                       CharacterSpacing="45" Foreground="{ThemeResource MutedTextBrush}"/>
            <TextBlock Text="Your trophy collection" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="A player-wide collection of achievements earned across your games."
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="ALL GAMES" FontSize="12" FontWeight="SemiBold"
                               CharacterSpacing="35" Foreground="{ThemeResource MutedTextBrush}"/>
                    <ListView x:Name="GamesList" Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                              SelectionMode="Single" SelectionChanged="GamesList_SelectionChanged"
                              Visibility="{x:Bind ViewModel.CarouselVisible, Mode=OneWay}"
                              Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:GameSummary">
                                <Grid ColumnSpacing="12" Margin="6,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="56" Height="76" CornerRadius="4"
                                            Background="{ThemeResource SurfaceTwoBrush}"
                                            BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1">
                                        <Grid>
                                            <Ellipse Width="36" Height="36"
                                                     Stroke="{ThemeResource NavigationAccentBrush}"
                                                     StrokeThickness="1" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="PS2" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayName}" FontSize="14" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" MaxLines="2"/>
                                        <TextBlock Text="No verified trophy set" Style="{StaticResource CaptionStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="EmptyLibraryPanel" Grid.Row="1" Spacing="8"
                                VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="260"
                                Visibility="{x:Bind ViewModel.EmptyVisible, Mode=OneWay}">
                        <TextBlock Text="No games in your library yet." FontSize="15" FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                        <Button Click="AddGame_Click" HorizontalAlignment="Center">
                            <TextBlock Text="Add a game"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.ErrorVisible, Mode=OneWay}"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{ThemeResource SurfaceOneBrush}" CornerRadius="10" Padding="32">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="520">
                    <FontIcon Glyph="&#xE734;" FontSize="34" Foreground="{ThemeResource MutedTextBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="No verified achievements yet" FontSize="23" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SelectedGameText" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="Trophy support is not available in this build. When supported, achievements from every game in your library will appear in this collection."
                               Style="{StaticResource PageSubtitleStyle}" TextAlignment="Center"/>
                    <Button x:Name="ViewGameDetailsButton" Click="ViewGameDetails_Click"
                            HorizontalAlignment="Center" Margin="0,4,0,0" IsEnabled="False">
                        <TextBlock Text="View game details"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
