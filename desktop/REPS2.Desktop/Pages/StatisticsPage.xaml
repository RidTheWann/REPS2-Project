<Page
    x:Class="REPS2.Desktop.Pages.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">
    <Grid Padding="48,32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock Text="PLAYER / STATISTIK" FontSize="12" FontWeight="SemiBold"
                       CharacterSpacing="45" Foreground="{ThemeResource MutedTextBrush}"/>
            <TextBlock Text="Your time. Your collection." Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Session insights appear only when supported by recorded evidence."
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="PLAY TIME" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Text="—" FontSize="32" FontWeight="SemiBold"/>
                    <TextBlock Text="No verified gameplay sessions" Style="{StaticResource CaptionStyle}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="SESSIONS" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Text="—" FontSize="32" FontWeight="SemiBold"/>
                    <TextBlock Text="No session history available" Style="{StaticResource CaptionStyle}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="TROPHY PROGRESS" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Text="—" FontSize="32" FontWeight="SemiBold"/>
                    <TextBlock Text="No supported trophy source" Style="{StaticResource CaptionStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Session history" FontSize="18" FontWeight="SemiBold"/>
                    <Border BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,0,0,1"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                MinHeight="180">
                        <TextBlock Text="Your next chapter is still ahead." FontSize="20"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="No playtime chart is shown without verified session records."
                                   Style="{StaticResource PageSubtitleStyle}" TextAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Collection overview" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.CollectionCount, Mode=OneWay}" FontSize="32"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Imported titles in your library" Style="{StaticResource CaptionStyle}"/>
                    <Border BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                            Margin="0,4"/>
                    <TextBlock Text="No runtime or performance measurements are simulated."
                               Style="{StaticResource PageSubtitleStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
