<Application
    x:Class="REPS2.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI controls such as NavigationView require the default Fluent resources. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1120"/>
            <SolidColorBrush x:Key="DeepSurfaceBrush" Color="#070B14"/>
            <SolidColorBrush x:Key="SurfaceOneBrush" Color="#111A2E"/>
            <SolidColorBrush x:Key="SurfaceTwoBrush" Color="#16213A"/>
            <SolidColorBrush x:Key="SurfaceThreeBrush" Color="#1D2A47"/>
            <SolidColorBrush x:Key="InsetBrush" Color="#0A0F1C"/>
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E8EDF7"/>
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A7B4CC"/>
            <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA8C0"/>
            <SolidColorBrush x:Key="BrandBrush" Color="#6E8BFF"/>
            <SolidColorBrush x:Key="BrandSubtleBrush" Color="#25345B"/>
            <SolidColorBrush x:Key="RunBrush" Color="#22C55E"/>
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#29334A"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#EF6B75"/>
            <SolidColorBrush x:Key="InfoBrush" Color="#7FAEFF"/>
            <SolidColorBrush x:Key="BuiltBrush" Color="#5FD3E6"/>

            <!-- Extend the Fluent defaults; replacing them removes required control templates. -->
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{StaticResource SurfaceTwoBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="40"/>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="Background" Value="{StaticResource InsetBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                <Setter Property="PlaceholderForeground" Value="{StaticResource MutedTextBrush}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="40"/>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="Background" Value="{StaticResource InsetBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                <Setter Property="MinHeight" Value="40"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
