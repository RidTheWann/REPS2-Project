<Application
    x:Class="REPS2.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F6"/>
                    <SolidColorBrush x:Key="DeepSurfaceBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SurfaceOneBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SurfaceTwoBrush" Color="#F7F8FA"/>
                    <SolidColorBrush x:Key="SurfaceThreeBrush" Color="#EEF0F3"/>
                    <SolidColorBrush x:Key="InsetBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#16181C"/>
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#4B5563"/>
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#667085"/>
                    <SolidColorBrush x:Key="BrandBrush" Color="#9D2638"/>
                    <SolidColorBrush x:Key="BrandSubtleBrush" Color="#F9EAEC"/>
                    <SolidColorBrush x:Key="BrandForegroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="NavigationAccentBrush" Color="#9D2638"/>
                    <SolidColorBrush x:Key="AccentFillBrush" Color="#9D2638"/>
                    <SolidColorBrush x:Key="AccentOnFillBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="RunBrush" Color="#9D2638"/>
                    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#D7DCE3"/>
                    <SolidColorBrush x:Key="DangerBrush" Color="#B42318"/>
                    <SolidColorBrush x:Key="InfoBrush" Color="#1D4ED8"/>
                    <SolidColorBrush x:Key="BuiltBrush" Color="#475467"/>
                    <SolidColorBrush x:Key="StatusBarBrush" Color="#FAFBFC"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#090B0D"/>
                    <SolidColorBrush x:Key="DeepSurfaceBrush" Color="#101214"/>
                    <SolidColorBrush x:Key="SurfaceOneBrush" Color="#181B1E"/>
                    <SolidColorBrush x:Key="SurfaceTwoBrush" Color="#22262A"/>
                    <SolidColorBrush x:Key="SurfaceThreeBrush" Color="#34393E"/>
                    <SolidColorBrush x:Key="InsetBrush" Color="#101214"/>
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F5F6"/>
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AFB5BC"/>
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#858E98"/>
                    <SolidColorBrush x:Key="BrandBrush" Color="#C43C4B"/>
                    <SolidColorBrush x:Key="BrandSubtleBrush" Color="#2A171B"/>
                    <SolidColorBrush x:Key="BrandForegroundBrush" Color="#F4F5F6"/>
                    <SolidColorBrush x:Key="NavigationAccentBrush" Color="#C43C4B"/>
                    <SolidColorBrush x:Key="AccentFillBrush" Color="#F4F5F6"/>
                    <SolidColorBrush x:Key="AccentOnFillBrush" Color="#101214"/>
                    <SolidColorBrush x:Key="RunBrush" Color="#C43C4B"/>
                    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#34393E"/>
                    <SolidColorBrush x:Key="DangerBrush" Color="#C43C4B"/>
                    <SolidColorBrush x:Key="InfoBrush" Color="#7FB2FF"/>
                    <SolidColorBrush x:Key="BuiltBrush" Color="#AFB5BC"/>
                    <SolidColorBrush x:Key="StatusBarBrush" Color="#101214"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/>
            </Style>
            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="MonoTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="IsTextSelectionEnabled" Value="True"/>
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceOneBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="24"/>
            </Style>
            <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource AccentFillBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource AccentOnFillBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="20,12"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="MinHeight" Value="48"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style x:Key="AccentButtonTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AccentOnFillBrush}"/>
            </Style>
            <Style x:Key="HeaderNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="MinHeight" Value="58"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI"/>
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SurfaceTwoBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="20,12"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="MinHeight" Value="48"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="Background" Value="{ThemeResource InsetBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}"/>
                <Setter Property="PlaceholderForeground" Value="{ThemeResource MutedTextBrush}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="MinHeight" Value="48"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="Background" Value="{ThemeResource InsetBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}"/>
                <Setter Property="MinHeight" Value="48"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>