<Window
    x:Class="REPS2.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="REPS2 Desktop Alpha">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource DeepSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource BrandSubtleBrush}" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7FC;" FontSize="19" Foreground="{StaticResource BrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="REPS2" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="NATIVE PLAYSTATION 2 PLATFORM" FontSize="9" CharacterSpacing="110" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                    <Border CornerRadius="5" Background="{StaticResource BrandSubtleBrush}" Padding="8,4" Margin="8,0,0,0">
                        <TextBlock Text="DESKTOP ALPHA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ToolchainBadge" Text="Checking toolchain…" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdateStatusText" Text="Updates checked on startup" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="UpdateProgress" Width="82" Height="5" Minimum="0" Maximum="100" Visibility="Collapsed" VerticalAlignment="Center"/>
                    <Button x:Name="CancelBuildButton" Content="Cancel build" Click="CancelBuild_Click"
                            Padding="10,6" MinHeight="32" FontSize="11" Visibility="Collapsed"/>
                    <Button x:Name="UpdateButton" Content="Check updates" Click="UpdateButton_Click" Padding="10,6" MinHeight="32" FontSize="11"/>
                </StackPanel>
                <Button x:Name="AddGameButton" Grid.Column="2" Click="AddGame_Click" Background="{StaticResource BrandBrush}" Foreground="#0A0F1C" BorderThickness="0" FontWeight="SemiBold" Margin="24,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock Text="Add game"/></StackPanel>
                </Button>
            </Grid>
        </Border>
        <NavigationView x:Name="AppNavigation" Grid.Row="1"
                        PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="224"
                        CompactPaneLength="64" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" SelectionChanged="Navigation_SelectionChanged"
                        Background="{StaticResource AppBackgroundBrush}">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Library" Tag="Library"><NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Add Game" Tag="AddGame"><NavigationViewItem.Icon><SymbolIcon Symbol="Add"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Build Queue" Tag="BuildQueue"><NavigationViewItem.Icon><SymbolIcon Symbol="Clock"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Developer Center" Tag="Developer"><NavigationViewItem.Icon><SymbolIcon Symbol="Repair"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="Settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" NavigationFailed="ContentFrame_NavigationFailed"/>
        </NavigationView>
        <Border Grid.Row="2" Background="{StaticResource DeepSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready · Imported does not mean playable" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Windows x64  ·  RG REPS2 ENGINE" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
